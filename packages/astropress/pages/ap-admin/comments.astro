---
import AdminLayout from "@astropress-diy/astropress/components/AdminLayout.astro";
import AuditTrail from "@astropress-diy/astropress/components/AuditTrail.astro";
import CsrfInput from "@astropress-diy/astropress/components/CsrfInput.astro";
import { buildCommentsPageModel, getPageT, requiresAccess, resolveAdminLocale } from "astropress";

// #104: gate the comments queue on comments:moderate; denied subjects are
// redirected rather than rendered (also removes the anon adminUser deref).
const guard = await requiresAccess(Astro, "comments:moderate");
if (guard) return guard;
const adminUser = Astro.locals.adminUser;
if (!adminUser) return Astro.redirect("/ap-admin/login");
const model = await buildCommentsPageModel(Astro.locals);
const { comments, auditEvents } = model.data;
const wasSaved = Astro.url.searchParams.get("saved") === "1";
const errorMessage =
	Astro.url.searchParams.get("error") === "1" ? Astro.url.searchParams.get("message") : "";
const t = getPageT(resolveAdminLocale(Astro));
function tCommentStatus(s: string): string {
	switch (s) {
		case "pending":
			return t("comments.statusPending");
		case "approved":
			return t("comments.statusApproved");
		case "rejected":
			return t("comments.statusRejected");
		default:
			return s;
	}
}
function tCommentPolicy(p: string): string {
	if (p === "open-moderated") return t("comments.policyOpenModerated");
	return p;
}
---

<AdminLayout
  title={t("comments.pageTitle")}
  heading={t("comments.pageTitle")}
  currentPath="/ap-admin/comments"
  description={t("comments.description")}
  userName={adminUser.name}
>
  {model.warnings.length > 0 && <ap-notice type="info">{t("comments.partialResults")}</ap-notice>}
  {wasSaved && <ap-notice type="success" dismiss-after="6000">{t("comments.savedSuccess")}</ap-notice>}
  {errorMessage && <ap-notice type="error">{errorMessage}</ap-notice>}
  <div class="admin-subgrid two summary-grid">
    <section class="panel stat summary-card">
      <span>{t("comments.totalComments")}</span>
      <strong>{comments.length}</strong>
      <span>{t("comments.totalCommentsDesc")}</span>
    </section>
    <section class="panel stat summary-card">
      <span>{t("comments.pendingReview")}</span>
      <strong>{comments.filter((comment) => comment.status === "pending").length}</strong>
      <span>{t("comments.pendingReviewDesc")}</span>
    </section>
  </div>
  <section class="panel comments-panel">
    <div class="section-header">
      <div>
        <p class="admin-kicker">{t("comments.moderation")}</p>
        <h2>{t("comments.moderationQueue")}</h2>
        <p>{t("comments.moderationQueueDesc")}</p>
      </div>
    </div>
    <div class="admin-table-shell">
      <table aria-label={t("comments.queueAria")}>
        <thead>
          <tr>
            <th>{t("comments.author")}</th>
            <th>{t("comments.route")}</th>
            <th>{t("common.status")}</th>
            <th>{t("comments.policy")}</th>
            <th>{t("comments.action")}</th>
          </tr>
        </thead>
        <tbody>
          {comments.length === 0 && (
            <tr><td colspan="5" class="admin-empty-state">{t("comments.empty")}</td></tr>
          )}
          {comments.map((comment) => (
            <tr>
              <td>{comment.author}</td>
              <td><code>{comment.route}</code></td>
              <td><span class="admin-chip">{tCommentStatus(comment.status)}</span></td>
              <td>{tCommentPolicy(comment.policy)}</td>
              <td class="action-cell">
                <form method="post" action="/ap-admin/actions/comment-moderate" class="comment-action">
                  <CsrfInput token={Astro.locals.csrfToken} />
                  <input type="hidden" name="commentId" value={comment.id} />
                  <input type="hidden" name="status" value="approved" />
                  <button type="submit" class="admin-button small">{t("comments.approve")}</button>
                </form>
                <button
                  type="button"
                  class="admin-button-ghost small reject"
                  data-confirm-reject
                  data-confirm-trigger
                  data-dialog-id="reject-dialog"
                  data-field-name="commentId"
                  data-field-value={comment.id}
                  data-text-reject-author={comment.author}
                  data-text-reject-route={comment.route}
                >
                  {t("comments.reject")}
                </button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  {/* Rejection Confirmation Dialog */}
  <ap-confirm-dialog>
    <dialog id="reject-dialog" class="confirm-modal" aria-labelledby="reject-dialog-title">
      <div class="modal-content">
        <h2 id="reject-dialog-title">{t("comments.rejectDialogTitle")}</h2>
        <p>{t("comments.rejectDialogBody")}</p>
        <p class="dialog-context">
          <strong id="reject-author"></strong> on <strong id="reject-route"></strong>
        </p>
        <div class="modal-actions">
          <button type="button" class="admin-button-ghost small secondary-button" data-dialog-close>{t("comments.cancel")}</button>
          <form id="reject-form" method="post" action="/ap-admin/actions/comment-moderate" style="display: inline;">
            <CsrfInput token={Astro.locals.csrfToken} />
            <input type="hidden" name="commentId" value="" />
            <input type="hidden" name="status" value="rejected" />
            <button type="submit" class="admin-button small reject-button">{t("comments.reject")}</button>
          </form>
        </div>
      </div>
    </dialog>
  </ap-confirm-dialog>

  <AuditTrail events={auditEvents.filter((event) => event.targetType === "comment").slice(0, 5)} />
  <script>
    import "../../web-components/confirm-dialog";
  </script>
</AdminLayout>

<style>
  .summary-grid,
  .comments-panel {
    margin-bottom: 1rem;
  }

  .summary-card span:first-child {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    font-weight: 700;
  }

  .summary-card span:last-child {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .comments-panel {
    display: grid;
    gap: 1rem;
  }

  .action-cell {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .comment-action {
    display: inline-flex;
  }

  [data-confirm-reject] {
    border-color: color-mix(in srgb, var(--danger) 50%, var(--line));
    color: var(--danger);
  }

  [data-confirm-reject]:hover {
    background: color-mix(in srgb, var(--danger) 10%, transparent);
  }


  .secondary-button {
    padding: 0;
  }

  .secondary-button:hover {
    background: var(--accent-soft);
  }

  .reject-button {
    background: var(--danger);
  }

  .reject-button:hover {
    background: #a83021;
  }
</style>
