---
import {
	buildAcceptInvitePageModel,
	buildAstropressAdminDocumentTitle,
	getPageT,
	localeDirection,
	resolveAdminLocale,
	resolveAstropressAdminUiConfig,
} from "astropress";

const token = Astro.url.searchParams.get("token") ?? "";
const hasError = Astro.url.searchParams.get("error") === "1";
const model = await buildAcceptInvitePageModel(Astro.locals, token);
const { inviteRequest } = model.data;
const adminLocale = resolveAdminLocale(Astro);
const adminDir = localeDirection(adminLocale);
const adminUi = resolveAstropressAdminUiConfig(adminLocale);
const t = getPageT(adminLocale);
const errorMessage = Astro.url.searchParams.get("message") ?? t("acceptInvite.defaultErrorMessage");
---

<!doctype html>
<html lang={adminLocale} dir={adminDir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    {adminUi.branding.faviconHref && <link rel="icon" href={adminUi.branding.faviconHref} />}
    {adminUi.branding.stylesheetHref && <link rel="stylesheet" href={adminUi.branding.stylesheetHref} />}
    <title>{buildAstropressAdminDocumentTitle(t("acceptInvite.docTitle"))}</title>
  </head>
  <body>
    <main class="login-shell">
      <section class="login-card">
        <div class="login-card-top">
          {adminUi.branding.logoSrc && <img src={adminUi.branding.logoSrc} alt={adminUi.branding.logoAlt} class="auth-logo" />}
          <p class="eyebrow">{adminUi.branding.appName}</p>
          <button
            type="button"
            class="theme-toggle-admin"
            id="auth-theme-toggle"
            aria-pressed="false"
            aria-label={adminUi.labels.themeToggleDark}
            title={adminUi.labels.themeToggleDark}
            data-theme-label-dark={adminUi.labels.themeToggleDark}
            data-theme-label-light={adminUi.labels.themeToggleLight}
          >
            <span class="theme-toggle-icon" aria-hidden="true"></span>
          </button>
        </div>
        <h1>{adminUi.labels.acceptInvitationHeading}</h1>
        <p>{adminUi.labels.acceptInvitationDescription}</p>

        {model.warnings.length > 0 && (
          <div class="message-block error-summary" tabindex="-1" aria-live="polite" data-focus-summary>
            <p class="error">{t("acceptInvite.tokenValidationFallback")}</p>
          </div>
        )}
        {hasError && (
          <div class="message-block error-summary" tabindex="-1" aria-live="polite" data-focus-summary>
            <p class="error">{errorMessage}</p>
          </div>
        )}

        {inviteRequest ? (
          <>
            <p class="account-summary">
              {t("acceptInvite.invitedAccountForPrefix")} <strong>{inviteRequest.name}</strong> ({inviteRequest.email}).
            </p>
            <form method="post" action="/ap-admin/actions/accept-invite">
              <input type="hidden" name="token" value={token} />
              <label>
                <span>{t("acceptInvite.newPassword")}</span>
                <input type="password" name="password" autocomplete="new-password" minlength="12" required data-error-required="Password is required" data-error-minlength="Password must be at least 12 characters" />
              </label>
              <label>
                <span>{t("acceptInvite.confirmNewPassword")}</span>
                <input type="password" name="confirmPassword" autocomplete="new-password" minlength="12" required data-error-required="Please confirm your password" data-error-minlength="Password must be at least 12 characters" />
              </label>
                <button type="submit">{adminUi.labels.acceptInvitationSubmit}</button>
              </form>
            </>
          ) : (
            <div class="message-block error-summary" tabindex="-1" aria-live="polite" data-focus-summary>
              <p class="error">{t("acceptInvite.defaultErrorMessage")}</p>
            </div>
          )}

        <p class="aux-link"><a href="/ap-admin/login">{adminUi.labels.backToLogin}</a></p>
      </section>
    </main>
    <script>
      import "../../src/client/theme-toggle";

      window.addEventListener("DOMContentLoaded", () => {
        document.querySelector<HTMLElement>("[data-focus-summary]")?.focus();
      });
    </script>
  </body>
</html>

<style>
  :root {
    color-scheme: light;
    --bg: #eff4f7;
    --card: #fffefb;
    --text: #1d2733;
    --accent: #0d5c63;
    --line: #d8dee5;
    --error: #a11f36;
    --button-bg: #0d5c63;
    --button-text: #ffffff;
    --button-hover: #0b4d54;
    --surface-glow: radial-gradient(circle at top, #dceef0 0%, var(--bg) 48%, #edf1e8 100%);
  }

  html[data-theme="dark"] {
    color-scheme: dark;
    --bg: #101815;
    --card: #18231f;
    --text: #edf4ef;
    --accent: #c1e7cb;
    --line: #31433b;
    --error: #ff9bb0;
    --button-bg: #c1e7cb;
    --button-text: #0a1f12;
    --button-hover: #d0eed8;
    --surface-glow: radial-gradient(circle at top, #203429 0%, #101815 48%, #17211d 100%);
  }

  html {
    font-family: "Trebuchet MS", "Segoe UI", sans-serif;
    background: var(--surface-glow);
    color: var(--text);
  }

  body {
    margin: 0;
  }

  .login-shell {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 1.5rem;
  }

  .login-card {
    position: relative;
    width: min(100%, 32rem);
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 1.25rem;
    padding: 1.5rem;
    box-shadow: 0 20px 60px rgba(17, 30, 42, 0.08);
  }

  html[data-theme="dark"] .login-card {
    box-shadow: 0 22px 70px rgba(0, 0, 0, 0.34);
  }

  .login-card-top {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 1rem;
    margin-bottom: 0.35rem;
  }

  .eyebrow {
    margin: 0 0 0.35rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--accent);
  }

  .auth-logo {
    width: 2rem;
    height: 2rem;
    object-fit: contain;
    border-radius: 0.35rem;
  }

  .theme-toggle-admin {
    position: absolute;
    top: 1.1rem;
    right: 1.1rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.8rem;
    height: 2.8rem;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--text);
    cursor: pointer;
  }

  .theme-toggle-icon {
    font-size: 1.35rem;
    line-height: 1;
  }

  h1 {
    margin: 0 0 0.5rem;
  }

  form {
    display: grid;
    gap: 1rem;
    margin-top: 1.25rem;
  }

  label {
    display: grid;
    gap: 0.4rem;
  }

  input {
    border: 1px solid var(--line);
    border-radius: 0.7rem;
    padding: 0.8rem 0.9rem;
    font: inherit;
    background: var(--card);
    color: var(--text);
  }

  button[type="submit"] {
    border: 0;
    border-radius: 0.75rem;
    padding: 0.85rem 1rem;
    background: var(--button-bg);
    color: var(--button-text);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  button[type="submit"]:hover,
  button[type="submit"]:focus-visible {
    background: var(--button-hover);
  }

  .message-block {
    margin-top: 1rem;
  }

  .error {
    color: var(--error);
    font-weight: 700;
  }

  .account-summary {
    margin: 1rem 0 0;
    color: var(--text);
  }

  .aux-link {
    margin: 1rem 0 0;
    font-size: 0.95rem;
  }

  .aux-link a {
    color: var(--accent);
    font-weight: 600;
  }
</style>
