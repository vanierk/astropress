---
import { safeAdminUserName } from "astropress";
import AdminLayout from "@astropress-diy/astropress/components/AdminLayout.astro";
import { buildSeoPageModel, getPageT, resolveAdminLocale } from "astropress";

const adminUser = Astro.locals.adminUser;
const selectedType = Astro.url.searchParams.get("type") ?? "all";
const missingOnly = Astro.url.searchParams.get("missing") === "1";
const sortKey = Astro.url.searchParams.get("sort") ?? "path";
const model = await buildSeoPageModel(Astro.locals, adminUser);
const t = getPageT(resolveAdminLocale(Astro));

if (model.status === "forbidden") {
	Astro.response.status = 403;
}
const rows = model.data.rows;
const sortedRows = [...rows].sort((left, right) => {
	if (sortKey === "status") {
		if (left.missingMetadata === right.missingMetadata) {
			return left.path.localeCompare(right.path);
		}
		return Number(left.missingMetadata) - Number(right.missingMetadata);
	}

	if (sortKey === "title") {
		return left.label.localeCompare(right.label);
	}

	if (sortKey === "type") {
		return left.type.localeCompare(right.type) || left.path.localeCompare(right.path);
	}

	return left.path.localeCompare(right.path);
});
const visibleRows = sortedRows.filter(
	(row) =>
		(selectedType === "all" || row.type === selectedType) && (!missingOnly || row.missingMetadata),
);
const countsByType = rows.reduce<Record<string, number>>((accumulator, row) => {
	accumulator[row.type] = (accumulator[row.type] ?? 0) + 1;
	return accumulator;
}, {});
const rowsMissingMetadata = rows.filter((row) => row.missingMetadata).length;
---

{model.status !== "forbidden" ? (
  <AdminLayout
    title={t("seo.title")}
    heading={t("seo.title")}
    currentPath="/ap-admin/seo"
    description={t("seo.description")}
    userName={safeAdminUserName(adminUser)}
  >
    {model.warnings.length > 0 && <p class="notice">{t("seo.partialResults")}</p>}
    <div class="admin-subgrid two summary-grid">
      <section class="panel stat summary-card">
        <span>{t("seo.indexedRecords")}</span>
        <strong>{rows.length}</strong>
        <span>{t("seo.indexedRecordsDesc")}</span>
      </section>
      <section class="panel stat summary-card">
        <span>{t("seo.needsMetadata")}</span>
        <strong>{rowsMissingMetadata}</strong>
        <span>{t("seo.needsMetadataDesc")}</span>
      </section>
    </div>
    <section class="panel seo-panel">
      <div class="section-header">
        <div>
          <p class="admin-kicker">{t("seo.triageKicker")}</p>
          <h2>{t("seo.triageHeading")}</h2>
          <p>{t("seo.triageDesc")}</p>
        </div>
        <form method="get" class="seo-sort-form">
          <input type="hidden" name="type" value={selectedType} />
          {missingOnly && <input type="hidden" name="missing" value="1" />}
          <label>
            <span class="sr-only">{t("seo.sortRowsAria")}</span>
            <select class="admin-select" name="sort" aria-label={t("seo.sortRowsAria")}>
              <option value="path" selected={sortKey === "path"}>{t("seo.sortByPath")}</option>
              <option value="title" selected={sortKey === "title"}>{t("seo.sortByTitle")}</option>
              <option value="type" selected={sortKey === "type"}>{t("seo.sortByType")}</option>
              <option value="status" selected={sortKey === "status"}>{t("seo.sortByStatus")}</option>
            </select>
          </label>
          <button type="submit" class="admin-button">{t("seo.apply")}</button>
        </form>
      </div>
      <p><strong>{visibleRows.length} {t("seo.ofIndexed")} {rows.length} {t("seo.indexedItems")}</strong></p>
      <div class="seo-filters">
        <a href="/ap-admin/seo" class="admin-button-ghost small" aria-current={selectedType === "all" && !missingOnly ? "page" : undefined}>{t("seo.filterAll")}</a>
        <a href="/ap-admin/seo?type=Page" class="admin-button-ghost small" aria-current={selectedType === "Page" && !missingOnly ? "page" : undefined}>{t("seo.filterPages")} ({countsByType.Page ?? 0})</a>
        <a href="/ap-admin/seo?type=Post" class="admin-button-ghost small" aria-current={selectedType === "Post" && !missingOnly ? "page" : undefined}>{t("seo.filterPosts")} ({countsByType.Post ?? 0})</a>
        <a href="/ap-admin/seo?type=Structured%20Page" class="admin-button-ghost small" aria-current={selectedType === "Structured Page" && !missingOnly ? "page" : undefined}>{t("seo.filterStructured")} ({countsByType["Structured Page"] ?? 0})</a>
        <a href="/ap-admin/seo?type=Archive" class="admin-button-ghost small" aria-current={selectedType === "Archive" && !missingOnly ? "page" : undefined}>{t("seo.filterArchives")} ({countsByType.Archive ?? 0})</a>
        <a href="/ap-admin/seo?type=System" class="admin-button-ghost small" aria-current={selectedType === "System" && !missingOnly ? "page" : undefined}>{t("seo.filterSystem")} ({countsByType.System ?? 0})</a>
        <a
          href={selectedType === "all" ? `/ap-admin/seo?missing=1&sort=${encodeURIComponent(sortKey)}` : `/ap-admin/seo?type=${encodeURIComponent(selectedType)}&missing=1&sort=${encodeURIComponent(sortKey)}`}
          class="admin-button-ghost small"
          aria-current={missingOnly ? "page" : undefined}
        >
          {t("seo.missingOnly")}
        </a>
      </div>
      <p><strong>{t("seo.overview")}</strong></p>
      <div class="admin-table-shell">
        <table aria-label={t("seo.tableAria")}>
          <thead>
            <tr>
              <th>{t("common.title")}</th>
              <th>{t("seo.colType")}</th>
              <th>{t("common.path")}</th>
              <th>{t("seo.colSeoTitle")}</th>
              <th>{t("seo.colMetaDescription")}</th>
              <th>{t("common.status")}</th>
              <th>{t("seo.colEdit")}</th>
            </tr>
          </thead>
          <tbody>
            {visibleRows.map((row) => (
              <tr>
                <td>{row.label}</td>
                <td>{row.type}</td>
                <td><code>{row.path}</code></td>
                <td>{row.seoTitle}</td>
                <td>{row.metaDescription}</td>
                <td><span class="admin-chip">{row.missingMetadata ? t("seo.needsWork") : t("seo.ready")}</span></td>
                <td><a href={row.editHref} class="admin-button-ghost small">{t("seo.edit")}</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </AdminLayout>
) : (
  <AdminLayout
    title={t("pages.forbidden.title")}
    heading={t("pages.forbidden.title")}
    currentPath="/ap-admin/posts"
    description={t("pages.forbidden.description")}
    userName={safeAdminUserName(adminUser)}
  >
    <section class="panel">
      <p>{t("pages.forbidden.body")}</p>
    </section>
  </AdminLayout>
)}

<style>
  .summary-grid {
    margin-bottom: 1rem;
  }

  .summary-card span:first-child {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    font-weight: 700;
  }

  .summary-card span:last-child {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .seo-panel {
    display: grid;
    gap: 1rem;
  }

  code {
    background: var(--bg);
    padding: 0.2rem 0.4rem;
    border-radius: 0.3rem;
    font-family: monospace;
    font-size: 0.85rem;
  }

  .seo-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .seo-sort-form {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .seo-sort-form select,
  .seo-sort-form button {
    font: inherit;
  }

  .seo-sort-form button {
    padding: 0;
  }

  .seo-filters a[aria-current="page"] {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-soft);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }
</style>
