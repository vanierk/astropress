---
import { safeAdminUserName } from "astropress";
import AdminLayout from "@astropress-diy/astropress/components/AdminLayout.astro";
import AuditTrail from "@astropress-diy/astropress/components/AuditTrail.astro";
import CsrfInput from "@astropress-diy/astropress/components/CsrfInput.astro";
import { buildUsersPageModel, getPageT, resolveAdminLocale } from "astropress";
import { resolveFlashStore } from "@astropress-diy/astropress/admin-store-dispatch.js";
import { resolveSafeAdminHref } from "../../src/admin-link-utils";

const t = getPageT(resolveAdminLocale(Astro));

const adminUser = Astro.locals.adminUser;
const model = await buildUsersPageModel(Astro.locals, adminUser);
const { users, auditEvents } = model.data;
const wasCreated = Astro.url.searchParams.get("saved") === "1";
const userCreatedNoEmail = Astro.url.searchParams.get("user_created") === "1";
const wasSuspended = Astro.url.searchParams.get("suspended") === "1";
const wasRestored = Astro.url.searchParams.get("restored") === "1";
// Invite/reset links carry one-time secret tokens, so they are delivered via
// the flash store (opaque id in the URL) and consumed here once (#133). The
// consumed value is still normalised through resolveSafeAdminHref before use.
const inviteFlashId = Astro.url.searchParams.get("flash");
const resetFlashId = Astro.url.searchParams.get("reset_flash");
const flash = inviteFlashId || resetFlashId ? await resolveFlashStore(Astro.locals) : null;
const inviteLinkRaw = flash && inviteFlashId ? await flash.consume(inviteFlashId) : null;
const resetLinkRaw = flash && resetFlashId ? await flash.consume(resetFlashId) : null;
const inviteLink = resolveSafeAdminHref(Astro.url, inviteLinkRaw, ["/ap-admin/accept-invite"]);
const resetLink = resolveSafeAdminHref(Astro.url, resetLinkRaw, ["/ap-admin/reset-password"]);
const errorMessage =
	Astro.url.searchParams.get("error") === "1" ? Astro.url.searchParams.get("message") : "";

if (model.status === "forbidden") {
	Astro.response.status = 403;
}
---

{model.status !== "forbidden" ? (
  <AdminLayout
    title={t("users.title")}
    heading={t("users.title")}
    description={t("users.description")}
    userName={safeAdminUserName(adminUser)}
    currentPath="/ap-admin/users"
  >
    {model.warnings.length > 0 && <p class="notice">{t("users.partialNotice")}</p>}
    {wasCreated && <p class="notice">{t("users.invitationIssued")}</p>}
    {userCreatedNoEmail && <p class="notice">{t("users.userCreatedNoEmail")}</p>}
    {wasSuspended && <p class="notice">{t("users.userSuspended")}</p>}
    {wasRestored && <p class="notice">{t("users.userRestored")}</p>}
    {inviteLink && <p class="notice">{t("users.invitationLink")}<a href={inviteLink}>{inviteLink}</a></p>}
    {resetLink && <p class="notice">{t("users.resetLinkPrefix")}<a href={resetLink}>{resetLink}</a></p>}
    {errorMessage && <p class="error-notice">{errorMessage}</p>}
    <div class="notice intro-notice">
      {t("users.intro")}
    </div>

    <div class="admin-subgrid two summary-grid">
      <section class="panel stat summary-card">
        <span>{t("users.totalUsers")}</span>
        <strong>{users.length}</strong>
        <span>{t("users.totalUsersDesc")}</span>
      </section>
      <section class="panel stat summary-card">
        <span>{t("users.pendingInvites")}</span>
        <strong>{users.filter((user) => user.status === "invited").length}</strong>
        <span>{t("users.pendingInvitesDesc")}</span>
      </section>
    </div>

    <section class="panel users-panel">
      <div class="section-header">
        <div>
          <p class="admin-kicker">{t("users.accessControlKicker")}</p>
          <h2>{t("users.currentUsers")}</h2>
          <p>{t("users.currentUsersDesc")}</p>
        </div>
      </div>
      <div class="admin-table-shell">
        <table aria-label={t("users.adminUsersAria")}>
          <thead>
            <tr>
              <th>{t("users.colName")}</th>
              <th>{t("users.colEmail")}</th>
              <th>{t("users.colRole")}</th>
              <th>{t("users.colJoined")}</th>
              <th>{t("common.status")}</th>
              <th>{t("common.actions")}</th>
            </tr>
          </thead>
          <tbody>
            {
              users.map((user) => {
                const isSuspended = user.status === "suspended";
                const isInvited = user.status === "invited";
                return (
                  <tr>
                    <td class="strong-cell">{user.name}</td>
                    <td>{user.email}</td>
                    <td>
                      <span class="admin-chip">{user.role}</span>
                    </td>
                    <td class="muted-cell">{user.createdAt.slice(0, 10)}</td>
                    <td>
                      {isSuspended ? (
                        <span class="status-chip suspended">{t("users.statusSuspended")}</span>
                      ) : isInvited ? (
                        <span class="status-chip invited">{t("users.statusInvited")}</span>
                      ) : (
                        <span class="status-chip active">{t("users.statusActive")}</span>
                      )}
                    </td>
                    <td>
                      <div class="user-actions">
                        {isSuspended ? (
                          <form method="post" action="/ap-admin/actions/user-unsuspend" class="admin-inline-form">
                            <CsrfInput token={Astro.locals.csrfToken} />
                            <input type="hidden" name="email" value={user.email} />
                            <button type="submit" class="admin-button small">{t("users.unsuspend")}</button>
                          </form>
                        ) : (
                          <>
                            <button
                              type="button"
                              class="admin-button-ghost small danger-ghost"
                              data-confirm-trigger
                              data-dialog-id="confirm-suspend-user"
                              data-field-name="email"
                              data-field-value={user.email}
                              data-text-suspend-email={user.email}
                            >
                              {t("users.suspend")}
                            </button>
                            <form method="post" action="/ap-admin/actions/user-reset-link" class="admin-inline-form">
                              <CsrfInput token={Astro.locals.csrfToken} />
                              <input type="hidden" name="email" value={user.email} />
                              <button type="submit" class="admin-button-ghost small">{t("users.resetLinkBtn")}</button>
                            </form>
                          </>
                        )}
                      </div>
                    </td>
                  </tr>
                );
              })
            }
          </tbody>
        </table>
      </div>
    </section>

    <section class="panel invite-panel">
      <div class="section-header">
        <div>
          <p class="admin-kicker">{t("users.createAccessKicker")}</p>
          <h2>{t("users.inviteUser")}</h2>
          <p>{t("users.inviteUserDesc")}</p>
        </div>
      </div>
      <form method="post" action="/ap-admin/actions/user-invite" class="form-grid admin-form-grid columns-3">
        <CsrfInput token={Astro.locals.csrfToken} />
        <div class="form-group admin-field">
          <label for="invite-name">{t("users.fullName")}</label>
          <input type="text" id="invite-name" name="name" required class="admin-input" />
        </div>
        <div class="form-group admin-field">
          <label for="invite-email">{t("users.email")}</label>
          <input type="email" id="invite-email" name="email" required class="admin-input" />
        </div>
        <div class="form-group admin-field">
          <label for="invite-role">{t("users.role")}</label>
          <select id="invite-role" name="role" required class="admin-select">
            <option value="editor">{t("users.roleEditor")}</option>
            <option value="admin">{t("users.roleAdmin")}</option>
          </select>
        </div>
        <div class="form-group form-actions">
          <button type="submit" class="admin-button">{t("users.sendInvitation")}</button>
        </div>
      </form>
      <p class="invite-note">
        {t("users.inviteNote")}
      </p>
    </section>

    <AuditTrail
      events={auditEvents.filter((event) => event.action.startsWith("user.") || event.action.startsWith("auth.")).slice(0, 6)}
      heading={t("users.userAndAccessAudit")}
    />

    <section class="panel gdpr-panel">
      <div class="section-header">
        <div>
          <p class="admin-kicker">{t("users.gdprKicker")}</p>
          <h2>{t("users.purgeUserData")}</h2>
          <p>
            {t("users.purgeUserDataDesc")}
          </p>
        </div>
      </div>
      <form method="post" action="/ap-admin/actions/user-purge" class="form-grid admin-form-grid columns-3" id="gdpr-purge-form">
        <CsrfInput token={Astro.locals.csrfToken} />
        <div class="form-group admin-field">
          <label for="purge-email">{t("users.purgeEmailLabel")}</label>
          <input type="email" id="purge-email" name="email" required class="admin-input" />
        </div>
        <div class="form-group admin-field admin-field--checkbox">
          <label>
            <input type="checkbox" name="deleteAccount" value="1" />
            {t("users.purgeDeleteCheckbox")}
          </label>
        </div>
        <div class="form-group form-actions">
          <button type="button" class="admin-button danger" id="purge-trigger">
            {t("users.purgeAndDownload")}
          </button>
        </div>
      </form>
    </section>

    <ap-confirm-dialog>
      <dialog id="confirm-suspend-user" class="confirm-modal" aria-labelledby="confirm-suspend-user-title">
        <div class="modal-content">
          <h2 id="confirm-suspend-user-title">{t("users.confirmSuspendTitle")}</h2>
          <p>{t("users.confirmSuspendBefore")}<strong id="suspend-email"></strong>{t("users.confirmSuspendAfter")}</p>
          <p>{t("users.confirmSuspendNote")}</p>
          <div class="modal-actions">
            <button type="button" class="admin-button-ghost small secondary-button" data-dialog-close>{t("users.cancel")}</button>
            <form method="post" action="/ap-admin/actions/user-suspend" style="display:inline;">
              <CsrfInput token={Astro.locals.csrfToken} />
              <input type="hidden" name="email" value="" />
              <button type="submit" class="admin-button small delete-button">{t("users.suspendUserBtn")}</button>
            </form>
          </div>
        </div>
      </dialog>
    </ap-confirm-dialog>

    <dialog id="confirm-purge-user" class="confirm-modal" aria-labelledby="confirm-purge-user-title">
      <div class="modal-content">
        <h2 id="confirm-purge-user-title">{t("users.confirmPurgeTitle")}</h2>
        <p>{t("users.confirmPurgeDesc")}</p>
        <p class="dialog-warning">{t("users.confirmPurgeWarning")}</p>
        <div class="modal-actions">
          <button type="button" class="admin-button-ghost small secondary-button" id="purge-cancel">{t("users.cancel")}</button>
          <button type="submit" form="gdpr-purge-form" class="admin-button small delete-button">{t("users.purgeAndDownloadShort")}</button>
        </div>
      </div>
    </dialog>

    <script>
      import "../../web-components/confirm-dialog";

      const purgeTrigger = document.getElementById("purge-trigger");
      const purgeDialog = document.getElementById("confirm-purge-user") as HTMLDialogElement | null;
      const purgeCancel = document.getElementById("purge-cancel");
      if (purgeTrigger && purgeDialog) {
        purgeTrigger.addEventListener("click", () => {
          const emailInput = document.getElementById("purge-email") as HTMLInputElement | null;
          if (emailInput && !emailInput.reportValidity()) return;
          purgeDialog.showModal();
        });
        purgeCancel?.addEventListener("click", () => purgeDialog.close());
      }
    </script>
  </AdminLayout>
) : (
  <AdminLayout
    title={t("pages.forbidden.title")}
    heading={t("pages.forbidden.title")}
    currentPath=""
    description={t("pages.forbidden.description")}
    userName={safeAdminUserName(adminUser)}
  >
    <section class="panel forbidden">
      <p>{t("pages.forbidden.body")}</p>
    </section>
  </AdminLayout>
)}

<style>
  .intro-notice,
  .summary-grid,
  .users-panel {
    margin-bottom: 1rem;
  }

  .summary-card span:first-child {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    font-weight: 700;
  }

  .summary-card span:last-child,
  .invite-note {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .users-panel,
  .invite-panel {
    display: grid;
    gap: 1rem;
  }

  .form-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .forbidden {
    max-width: 42rem;
  }

  .strong-cell {
    font-weight: 600;
  }

  .muted-cell {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .user-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .status-chip {
    display: inline-flex;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .status-chip.active {
    background: #e7f6ef;
    color: #16543b;
  }

  .status-chip.invited {
    background: #fff8df;
    color: #7a5a00;
  }

  .status-chip.suspended {
    background: #fff0f2;
    color: #8f1730;
  }

  .danger-ghost {
    border-color: color-mix(in srgb, var(--danger) 50%, var(--line));
    color: var(--danger);
  }

  .form-actions {
    grid-column: 1 / -1;
  }

  @media (max-width: 768px) {
    .form-grid {
      grid-template-columns: 1fr;
    }
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
</style>
