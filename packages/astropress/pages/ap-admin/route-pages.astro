---
import { safeAdminUserName } from "astropress";
import AdminLayout from "@astropress-diy/astropress/components/AdminLayout.astro";
import CsrfInput from "@astropress-diy/astropress/components/CsrfInput.astro";
import { buildRouteTablePageModel, getPageT, resolveAdminLocale } from "astropress";

const adminUser = Astro.locals.adminUser;
const model = await buildRouteTablePageModel(Astro.locals, adminUser);
const { routePages, settings } = model.data;
if (model.status === "forbidden") {
	Astro.response.status = 403;
}
const currentAdminSlug = settings.adminSlug || "ap-admin";
const isDefaultSlug = currentAdminSlug === "ap-admin";
const slugSaved = Astro.url.searchParams.get("slugSaved") === "1";
const slugError = Astro.url.searchParams.get("error");
const adminLocale = resolveAdminLocale(Astro);
const t = getPageT(adminLocale);
---

{model.status !== "forbidden" ? (
  <AdminLayout
    title={t("routePages.title")}
    heading={t("routePages.title")}
    currentPath="/ap-admin/route-pages"
    description={t("routePages.description")}
    userName={safeAdminUserName(adminUser)}
  >
    {model.warnings.length > 0 && <p class="notice">{t("routePages.partialResults")}</p>}

    <section class="panel admin-slug-panel">
      <div class="section-header">
        <div>
          <p class="admin-kicker">{t("routePages.securityKicker")}</p>
          <h2>{t("routePages.adminUrlHeading")}</h2>
          <p>
            {t("routePages.adminUrlIntroPrefix")} <code>/{currentAdminSlug}/</code>. {t("routePages.adminUrlIntroSuffix")}
          </p>
        </div>
      </div>

      {isDefaultSlug && (
        <div class="slug-warning" role="alert">
          <strong>{t("routePages.defaultSlugWarningStrong")} <code>/ap-admin/</code>.</strong> {t("routePages.defaultSlugWarningRest")}
        </div>
      )}

      {slugSaved && (
        <p class="slug-success">{t("routePages.slugSavedPrefix")} <code>/{currentAdminSlug}/route-pages</code>.</p>
      )}

      {slugError && (
        <p class="slug-error">{slugError}</p>
      )}

      <form method="post" action="/ap-admin/actions/admin-slug-save" class="slug-form">
        <CsrfInput token={Astro.locals.csrfToken} />
        <div class="slug-field">
          <label for="adminSlug">{t("routePages.adminUrlPrefixLabel")}</label>
          <div class="slug-input-row">
            <span class="slug-prefix">your-site.com/</span>
            <input
              type="text"
              id="adminSlug"
              name="adminSlug"
              value={currentAdminSlug}
              required
              pattern="[a-z0-9][a-z0-9\-]*[a-z0-9]|[a-z0-9]"
              title={t("routePages.slugInputTitle")}
              class="admin-input slug-input"
            />
            <span class="slug-suffix">/</span>
          </div>
          <p class="field-note">{t("routePages.slugFieldNote")} <code>admin</code> {t("routePages.slugFieldNoteOr")} <code>cms</code>.</p>
        </div>
        <div class="form-actions">
          <button type="submit" class="admin-button">{t("routePages.saveAdminUrl")}</button>
        </div>
      </form>
    </section>

    <section class="panel route-table-panel">
      <div class="section-header">
        <div>
          <p class="admin-kicker">{t("routePages.technicalInventory")}</p>
          <h2>{t("routePages.structuredRouteInventory")}</h2>
          <p>{t("routePages.structuredRouteDesc")}</p>
        </div>
        <a href="/ap-admin/pages" class="admin-button-secondary">{t("routePages.backToPages")}</a>
      </div>
      <div class="admin-table-shell">
        <table aria-label={t("routePages.tableAria")}>
          <thead>
            <tr>
              <th>{t("common.title")}</th>
              <th>{t("common.path")}</th>
              <th>{t("routePages.template")}</th>
              <th>{t("routePages.ownerEditor")}</th>
              <th>{t("routePages.publicView")}</th>
              <th>{t("common.updated")}</th>
            </tr>
          </thead>
          <tbody>
            {routePages.map((page) => (
              <tr>
                <td>
                  <a href={`/ap-admin/route-pages${page.path}`}>{page.title}</a>
                </td>
                <td><code>{page.path}</code></td>
                <td><span class="admin-chip">{page.templateKey}</span></td>
                <td><a href="/ap-admin/pages" class="admin-button-ghost small">{t("routePages.pages")}</a></td>
                <td><a href={page.path} target="_blank" rel="noreferrer" class="admin-button-ghost small">{t("routePages.openRoute")}</a></td>
                <td>{page.updatedAt ? new Date(page.updatedAt).toLocaleString(adminLocale) : t("routePages.seeded")}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </AdminLayout>
) : (
  <AdminLayout
    title={t("routePages.forbiddenTitle")}
    heading={t("routePages.forbiddenTitle")}
    currentPath="/ap-admin/posts"
    description={t("routePages.forbiddenDesc")}
    userName={safeAdminUserName(adminUser)}
  >
    <section class="panel">
      <p>{t("routePages.forbiddenBody")}</p>
    </section>
  </AdminLayout>
)}

<style>
  .route-table-panel {
    display: grid;
    gap: 1rem;
  }

  .admin-slug-panel {
    display: grid;
    gap: 1.25rem;
  }

  .slug-warning {
    background: #fff8e1;
    border: 1px solid #f59e0b;
    border-inline-start: 4px solid #f59e0b;
    border-radius: 4px;
    padding: 0.75rem 1rem;
    color: #78350f;
    font-size: 0.9rem;
  }

  .slug-success {
    background: #f0fdf4;
    border: 1px solid #22c55e;
    border-radius: 4px;
    padding: 0.6rem 1rem;
    color: #166534;
    font-size: 0.9rem;
    margin: 0;
  }

  .slug-error {
    background: #fef2f2;
    border: 1px solid #ef4444;
    border-radius: 4px;
    padding: 0.6rem 1rem;
    color: #991b1b;
    font-size: 0.9rem;
    margin: 0;
  }

  .slug-form {
    display: grid;
    gap: 1rem;
    max-width: 480px;
  }

  .slug-field {
    display: grid;
    gap: 0.4rem;
  }

  .slug-field label {
    font-weight: 600;
    font-size: 0.9rem;
  }

  .slug-input-row {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .slug-prefix,
  .slug-suffix {
    color: var(--text-muted, #374151);
    font-size: 0.9rem;
    white-space: nowrap;
  }

  .slug-input {
    flex: 1;
    min-width: 0;
  }

  .form-actions {
    display: flex;
    gap: 0.75rem;
  }
</style>
