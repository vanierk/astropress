---
import { safeAdminUserName } from "astropress";
import AdminLayout from "@astropress-diy/astropress/components/AdminLayout.astro";
import CsrfInput from "@astropress-diy/astropress/components/CsrfInput.astro";
import { buildSystemPageModel, getPageT, resolveAdminLocale } from "astropress";

const adminUser = Astro.locals.adminUser;
const model = await buildSystemPageModel(Astro.locals, adminUser);
const { routeMap } = model.data;
const t = getPageT(resolveAdminLocale(Astro));
if (model.status === "forbidden") {
	Astro.response.status = 403;
}
const errorMessage =
	Astro.url.searchParams.get("error") === "1" ? Astro.url.searchParams.get("message") : "";
const wasSaved = Astro.url.searchParams.get("saved") === "1";

const errorPage = routeMap.get("/500");
const robotsPage = routeMap.get("/robots.txt");
const sitemapPage = routeMap.get("/sitemap.xml");
---

{model.status !== "forbidden" ? (
  <AdminLayout
    title={t("system.title")}
    heading={t("system.title")}
    currentPath="/ap-admin/system"
    description={t("system.description")}
    userName={safeAdminUserName(adminUser)}
  >
    {model.warnings.length > 0 && <p class="notice">{t("system.partialResults")}</p>}
    <div class="toolbar">
      <a href="/ap-admin/pages" class="admin-button-secondary">{t("system.backToPages")}</a>
      <a href="/500" target="_blank" rel="noreferrer" class="admin-button-ghost">{t("system.open500")}</a>
      <a href="/robots.txt" target="_blank" rel="noreferrer" class="admin-button-ghost">{t("system.openRobots")}</a>
      <a href="/sitemap.xml" target="_blank" rel="noreferrer" class="admin-button-ghost">{t("system.openSitemap")}</a>
    </div>
    {wasSaved && <p class="notice">{t("system.savedSuccess")}</p>}
    {errorMessage && <p class="error-notice">{errorMessage}</p>}

    <section class="panel system-section">
      <div class="section-header">
        <div>
          <p class="admin-kicker">{t("system.errorSurfaceKicker")}</p>
          <h2>{t("system.errorPageHeading")}</h2>
          <p>{t("system.errorPageDesc")}</p>
        </div>
      </div>
      <form method="post" action="/ap-admin/actions/system-route-save" class="system-form">
        <CsrfInput token={Astro.locals.csrfToken} />
        <input type="hidden" name="path" value="/500" />
        <p class="field-note">{t("system.publicRoute")} <a href="/500" target="_blank" rel="noreferrer">/500</a></p>
        <label class="admin-field">
          <span>{t("system.fieldTitle")}</span>
          <input class="admin-input" type="text" name="title" value={errorPage?.title ?? t("system.errorPageDefaultTitle")} required />
        </label>
        <label class="admin-field">
          <span>{t("system.fieldSummary")}</span>
          <input class="admin-input" type="text" name="summary" value={errorPage?.summary ?? ""} />
        </label>
        <label class="admin-field">
          <span>{t("system.fieldBody")}</span>
          <textarea class="admin-textarea" name="bodyHtml" rows="4">{errorPage?.bodyHtml ?? ""}</textarea>
        </label>
        <label class="admin-field">
          <span>{t("system.fieldButtonLabel")}</span>
          <input class="admin-input" type="text" name="buttonLabel" value={String(errorPage?.settings?.buttonLabel ?? t("system.errorPageDefaultButton"))} required />
        </label>
        <label class="admin-field">
          <span>{t("system.fieldButtonHref")}</span>
          <input class="admin-input" type="text" name="buttonHref" value={String(errorPage?.settings?.buttonHref ?? "/")} required />
        </label>
        <label class="admin-field">
          <span>{t("system.fieldContactHref")}</span>
          <input class="admin-input" type="text" name="contactHref" value={String(errorPage?.settings?.contactHref ?? "/en/contact")} required />
        </label>
        <label class="admin-field">
          <span>{t("system.fieldRevisionNote")}</span>
          <input class="admin-input" type="text" name="revisionNote" placeholder={t("system.revisionPlaceholder")} />
        </label>
        <button type="submit" class="admin-button">{t("system.save500")}</button>
      </form>
    </section>

    <section class="panel system-section">
      <div class="section-header">
        <div>
          <p class="admin-kicker">{t("system.crawlerOutputKicker")}</p>
          <h2>{t("system.robotsHeading")}</h2>
          <p>{t("system.robotsDesc")}</p>
        </div>
      </div>
      <form method="post" action="/ap-admin/actions/system-route-save" class="system-form">
        <CsrfInput token={Astro.locals.csrfToken} />
        <input type="hidden" name="path" value="/robots.txt" />
        <p class="field-note">{t("system.generatedPublicOutput")} <a href="/robots.txt" target="_blank" rel="noreferrer">/robots.txt</a></p>
        <label class="admin-field">
          <span>{t("system.fieldTitle")}</span>
          <input class="admin-input" type="text" name="title" value={robotsPage?.title ?? t("system.robotsDefaultTitle")} required />
        </label>
        <label class="admin-field">
          <span>{t("system.fieldBody")}</span>
          <textarea class="admin-textarea code-textarea" name="bodyHtml" rows="8">{robotsPage?.bodyHtml ?? ""}</textarea>
        </label>
        <label class="admin-field">
          <span>{t("system.fieldRevisionNote")}</span>
          <input class="admin-input" type="text" name="revisionNote" placeholder={t("system.revisionPlaceholder")} />
        </label>
        <button type="submit" class="admin-button">{t("system.saveRobots")}</button>
      </form>
    </section>

    <section class="panel system-section">
      <div class="section-header">
        <div>
          <p class="admin-kicker">{t("system.generatedSitemapKicker")}</p>
          <h2>{t("system.sitemapHeading")}</h2>
          <p>{t("system.sitemapDesc")}</p>
        </div>
      </div>
      <form method="post" action="/ap-admin/actions/system-route-save" class="system-form">
        <CsrfInput token={Astro.locals.csrfToken} />
        <input type="hidden" name="path" value="/sitemap.xml" />
        <p class="field-note">{t("system.generatedPublicOutput")} <a href="/sitemap.xml" target="_blank" rel="noreferrer">/sitemap.xml</a></p>
        <label class="admin-field">
          <span>{t("system.fieldTitle")}</span>
          <input class="admin-input" type="text" name="title" value={sitemapPage?.title ?? t("system.sitemapDefaultTitle")} required />
        </label>
        <label class="admin-field">
          <span>{t("system.fieldExcludedPaths")}</span>
          <textarea class="admin-textarea code-textarea" name="excludedPaths" rows="4" placeholder="/draft-page&#10;/legacy-path">{Array.isArray(sitemapPage?.settings?.excludedPaths) ? (sitemapPage?.settings?.excludedPaths as string[]).join("\n") : ""}</textarea>
        </label>
        <label class="admin-field">
          <span>{t("system.fieldExtraUrls")}</span>
          <textarea class="admin-textarea code-textarea" name="extraUrls" rows="4" placeholder={t("system.extraUrlsPlaceholder")}>{Array.isArray(sitemapPage?.settings?.extraUrls) ? (sitemapPage?.settings?.extraUrls as string[]).join("\n") : ""}</textarea>
        </label>
        <label class="admin-field">
          <span>{t("system.fieldRevisionNote")}</span>
          <input class="admin-input" type="text" name="revisionNote" placeholder={t("system.revisionPlaceholder")} />
        </label>
        <button type="submit" class="admin-button">{t("system.saveSitemap")}</button>
      </form>
    </section>
  </AdminLayout>
) : (
  <AdminLayout
    title={t("pages.forbidden.title")}
    heading={t("pages.forbidden.title")}
    currentPath=""
    description={t("pages.forbidden.description")}
    userName={safeAdminUserName(adminUser)}
  >
    <section class="panel forbidden">
      <p>{t("system.forbiddenBody")}</p>
    </section>
  </AdminLayout>
)}

<style>
  .system-section + .system-section {
    margin-top: 1rem;
  }

  .system-form {
    display: grid;
    gap: 0.9rem;
  }

  button.admin-button {
    width: fit-content;
  }

  .code-textarea {
    font-family: monospace;
  }

  .field-note a {
    color: var(--accent);
    font-weight: 700;
    text-decoration: none;
  }

  .field-note a:hover {
    text-decoration: underline;
  }

  .field-note {
    margin: 0;
    color: var(--muted);
  }
</style>
