---
import AdminLayout from "@astropress-diy/astropress/components/AdminLayout.astro";
import { getPageT, isAuthUserAdmin, resolveAdminLocale } from "astropress";
import { validateEmbedUrl } from "../../src/admin-embed-url";

const adminUser = Astro.locals.adminUser;
const t = getPageT(resolveAdminLocale(Astro));

// Require authentication
if (!adminUser) {
	return Astro.redirect("/ap-admin/login?return=/ap-admin/host", 302);
}

// Host panel is admin-only
if (!isAuthUserAdmin(adminUser)) {
	return Astro.redirect("/ap-admin", 302);
}

// Read hostPanel config from locals (set by the adapter's capabilities)
const hostPanel = (Astro.locals as Record<string, unknown>).hostPanel as
	| {
			mode: "iframe" | "link";
			url: string;
			label: string;
	  }
	| undefined;

if (!hostPanel) {
	return Astro.redirect("/ap-admin", 302);
}

// #109: validate the provider panel URL before it reaches an iframe src / href.
const embed = validateEmbedUrl(hostPanel.url);
---

<AdminLayout
  title={hostPanel.label}
  heading={hostPanel.label}
  currentPath="/ap-admin/host"
  description={`${t("host.descriptionPrefix")} ${hostPanel.label}`}
  userName={adminUser.name}
  hasHostPanel={true}
>
  {!embed.ok ? (
    <section class="panel host-link-panel" data-host-invalid-url>
      <div class="section-header">
        <div>
          <p class="admin-kicker">{t("host.kicker")}</p>
          <h2>{hostPanel.label}</h2>
          <p class="error-notice">{t("host.misconfiguredPrefix")} {embed.reason}</p>
          <p class="admin-note">{t("host.setUrlNotice")}</p>
        </div>
      </div>
    </section>
  ) : hostPanel.mode === "iframe" ? (
    <div class="host-frame-shell">
      <iframe
        src={embed.url}
        class="host-frame"
        title={`${hostPanel.label} ${t("host.iframeTitleSuffix")}`}
        allow="clipboard-write; fullscreen"
        data-host-panel
      />
    </div>
  ) : (
    <section class="panel host-link-panel">
      <div class="section-header">
        <div>
          <p class="admin-kicker">{t("host.kicker")}</p>
          <h2>{hostPanel.label}</h2>
          <p>{t("host.separateServiceNotice")}</p>
        </div>
      </div>
      <div class="host-link-actions">
        <a
          href={embed.url}
          target="_blank"
          rel="noopener noreferrer"
          class="admin-button"
          data-host-panel-link
        >
          {t("embedPanel.openPrefix")} {hostPanel.label}
        </a>
        <p class="admin-note">
          {t("embedPanel.opensPrefix")} <code>{embed.url}</code> {t("embedPanel.opensSuffix")}
        </p>
      </div>
    </section>
  )}
</AdminLayout>

<style>
  .host-frame-shell {
    position: fixed;
    top: 66px;
    left: 17rem;
    right: 0;
    bottom: 0;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 0.8rem 0 0 0;
    overflow: hidden;
  }

  .host-frame {
    width: 100%;
    height: 100%;
    border: none;
  }

  .host-link-panel {
    max-width: 38rem;
    padding: 1.5rem;
  }

  .host-link-actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: flex-start;
  }

  .host-link-actions code {
    font-size: 0.88rem;
    color: var(--muted);
    background: var(--surface-subtle);
    padding: 0.15rem 0.4rem;
    border-radius: 0.35rem;
  }

  @media (max-width: 900px) {
    .host-frame-shell {
      left: 0;
    }
  }
</style>
