---
import { safeAdminUserName } from "astropress";
import AdminLayout from "@astropress-diy/astropress/components/AdminLayout.astro";
import {
	buildPagesIndexPageModel,
	getPageT,
	isSeededPostRecord,
	resolveAdminLocale,
} from "astropress";

const adminUser = Astro.locals.adminUser;
const model = await buildPagesIndexPageModel(Astro.locals, adminUser);
const { contentStates, routePages, archiveRows } = model.data;
const adminLocale = resolveAdminLocale(Astro);
const t = getPageT(adminLocale);
function format(template: string, params: Record<string, string | number>) {
	return template.replace(/\{(\w+)\}/g, (_, k) => String(params[k] ?? ""));
}
function tKind(kind: string): string {
	switch (kind) {
		case "Legacy":
			return t("pages.kindLegacy");
		case "Structured":
			return t("pages.kindStructured");
		case "Archive":
			return t("pages.kindArchive");
		default:
			return kind;
	}
}
function tStatus(status: string): string {
	switch (status) {
		case "published":
			return t("common.published");
		case "draft":
			return t("common.draft");
		case "archived":
			return t("common.archived");
		case "review":
			return t("common.inReview");
		default:
			return status;
	}
}

if (model.status === "forbidden") {
	Astro.response.status = 403;
}

const searchQuery = Astro.url.searchParams.get("q")?.trim().toLowerCase() ?? "";
const selectedKind = Astro.url.searchParams.get("kind") ?? "all";

const legacyPages = contentStates
	.filter((record) => !isSeededPostRecord(record))
	.map((record) => ({
		title: record.title,
		path: record.legacyUrl,
		kind: "Legacy",
		status: record.status ?? "published",
		updatedAt: record.updatedAt,
		editHref: `/ap-admin/posts/${record.slug}`,
		publicHref: record.legacyUrl,
		ownerLabel: t("pages.editPageRow"),
	}));

const structuredPages = routePages
	.filter((page): page is NonNullable<typeof page> => page != null)
	.map((page) => ({
		title: page.title,
		path: page.path,
		kind: "Structured",
		status: "published",
		updatedAt: page.updatedAt,
		editHref: `/ap-admin/route-pages${page.path}`,
		publicHref: page.path,
		ownerLabel: t("pages.editRoutePage"),
	}));

const archivePages = archiveRows.map(({ archive, runtime }) => ({
	title: runtime?.title ?? archive.title,
	path: archive.legacyUrl,
	kind: "Archive",
	status: "published",
	updatedAt: runtime?.updatedAt,
	editHref: `/ap-admin/archives/${archive.slug}`,
	publicHref: archive.legacyUrl,
	ownerLabel: t("pages.editArchive"),
}));

const rows = [...legacyPages, ...structuredPages, ...archivePages].sort((left, right) =>
	left.path.localeCompare(right.path),
);
const filteredRows = rows.filter((row) => {
	const matchesKind = selectedKind === "all" || row.kind.toLowerCase() === selectedKind;
	const haystack = `${row.title} ${row.path} ${row.kind}`.toLowerCase();
	const matchesSearch = !searchQuery || haystack.includes(searchQuery);
	return matchesKind && matchesSearch;
});
const kindCounts = rows.reduce<Record<string, number>>((accumulator, row) => {
	accumulator[row.kind] = (accumulator[row.kind] ?? 0) + 1;
	return accumulator;
}, {});
const structuredExplanation = t("pages.structuredExplanation");
---

{model.status !== "forbidden" ? (
  <AdminLayout
    title={t("pages.pageTitle")}
    heading={t("pages.pageTitle")}
    currentPath="/ap-admin/pages"
    description={t("pages.description")}
    userName={safeAdminUserName(adminUser)}
  >
    {model.warnings.length > 0 && <p class="notice">{t("pages.partialResults")}</p>}
    <div class="toolbar">
      <a href="/ap-admin/pages/new" class="admin-button">{t("dashboard.newPage")}</a>
      <a href="/ap-admin/route-pages" class="admin-button-secondary">{t("pages.openRouteTable")}</a>
    </div>
    <div class="admin-subgrid two summary-grid">
      <section class="panel stat summary-card">
        <span>{t("pages.allPages")}</span>
        <strong>{rows.length}</strong>
        <span>{t("pages.allPagesDesc")}</span>
      </section>
      <section class="panel stat summary-card">
        <span>{t("pages.structuredPages")}</span>
        <strong>{kindCounts.Structured ?? 0}</strong>
        <span>{t("pages.structuredPagesDesc")}</span>
      </section>
    </div>
    <section class="panel page-index-panel">
      <div class="section-header">
        <div>
          <p class="admin-kicker">{t("pages.publicPageOwnership")}</p>
          <h2>{t("pages.pageIndex")}</h2>
          <p>{t("pages.useThisIndex")}</p>
        </div>
      </div>
      <div class="page-notes">
        <div class="note-card">
          <strong>{t("pages.structuredPages")}</strong>
          <p>{structuredExplanation}</p>
        </div>
        <div class="note-card">
          <strong>{t("pages.pageTypesInList")}</strong>
          <p><strong>{t("pages.kindLegacy")}</strong> {t("pages.legacyExplanation")} <strong>{t("pages.kindStructured")}</strong> {t("pages.structuredExplanation2")} <strong>{t("pages.kindArchive")}</strong> {t("pages.archiveExplanation")}</p>
        </div>
      </div>
      <div class="list-toolbar">
        <p><strong>{format(t("pages.ofPagesSummary"), { filtered: filteredRows.length, total: rows.length })}</strong></p>
        <form method="get" class="filter-form">
          <label>
            <span class="sr-only">{t("pages.searchPages")}</span>
            <input class="admin-input" type="search" name="q" value={Astro.url.searchParams.get("q") ?? ""} placeholder={t("pages.searchPlaceholder")} aria-label={t("pages.searchPages")} />
          </label>
          <label>
            <span class="sr-only">{t("pages.filterByKind")}</span>
            <select class="admin-select" name="kind" aria-label={t("pages.filterByKindAria")}>
              <option value="all" selected={selectedKind === "all"}>{t("pages.allKinds")}</option>
              <option value="legacy" selected={selectedKind === "legacy"}>{t("pages.kindLegacy")}</option>
              <option value="structured" selected={selectedKind === "structured"}>{t("pages.kindStructured")}</option>
              <option value="archive" selected={selectedKind === "archive"}>{t("pages.kindArchive")}</option>
            </select>
          </label>
          <button type="submit" class="admin-button">{t("common.applyFilters")}</button>
        </form>
      </div>
      <div class="admin-table-shell">
        <table aria-label={t("pages.pagesList")}>
          <thead>
            <tr>
              <th>{t("common.title")}</th>
              <th>{t("common.path")}</th>
              <th>{t("pages.kind")}</th>
              <th>{t("common.status")}</th>
              <th>{t("common.updated")}</th>
              <th>{t("common.actions")}</th>
            </tr>
          </thead>
          <tbody>
            {filteredRows.length === 0 && (
              <tr><td colspan="2" class="admin-empty-state">{t("pages.noMatch")} <a href="/ap-admin/pages">{t("common.clearFilters")}</a> {t("pages.noMatchOr")} <a href="/ap-admin/pages/new">{t("pages.createNewPage")}</a>.</td></tr>
            )}
            {filteredRows.map((row) => (
              <tr>
                <td>
                  <div class="page-title-cell">
                    <strong>{row.title}</strong>
                    <code>{row.path}</code>
                  </div>
                </td>
                <td><code>{row.path}</code></td>
                <td><span class={`kind-chip kind-${row.kind.toLowerCase()}`}>{tKind(row.kind)}</span></td>
                <td><span class={`status-chip status-${row.status.toLowerCase().replace(/\s+/g, "-")}`}>{tStatus(row.status)}</span></td>
                <td>{row.updatedAt ? new Date(row.updatedAt).toLocaleString(adminLocale) : t("pages.seeded")}</td>
                <td>
                  <div class="row-actions">
                    <a href={row.editHref} class="admin-button-ghost small">{row.ownerLabel}</a>
                    <a href={row.publicHref} target="_blank" rel="noreferrer" class="admin-button-ghost small">{t("pages.openPage")}</a>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </AdminLayout>
) : (
  <AdminLayout
    title={t("pages.forbidden.title")}
    heading={t("pages.forbidden.title")}
    currentPath="/ap-admin/posts"
    description={t("pages.forbidden.description")}
    userName={safeAdminUserName(adminUser)}
  >
    <section class="panel">
      <p>{t("pages.forbidden.body")}</p>
    </section>
  </AdminLayout>
)}

<style>
  .summary-grid {
    margin-bottom: 1rem;
  }

  .summary-card span:first-child {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    font-weight: 700;
  }

  .summary-card span:last-child {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .page-index-panel {
    display: grid;
    gap: 1rem;
  }

  .list-toolbar {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }

  .page-notes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 0.85rem;
    margin-bottom: 1rem;
  }

  .note-card {
    border: 1px solid var(--line);
    border-radius: 1rem;
    padding: 1rem;
    background: color-mix(in srgb, var(--panel) 94%, var(--accent-soft) 6%);
  }

  .note-card strong {
    display: block;
    margin-bottom: 0.35rem;
  }

  .note-card p {
    margin: 0;
    color: var(--muted);
    line-height: 1.5;
  }

  .filter-form {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    align-items: center;
  }

  .filter-form input,
  .filter-form select,
  .filter-form button {
    font: inherit;
    border-radius: 0.7rem;
    border: 1px solid var(--line);
    padding: 0.65rem 0.8rem;
  }

  .page-title-cell {
    display: grid;
    gap: 0.25rem;
  }

  .page-title-cell code {
    color: var(--muted);
    font-size: 0.84rem;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }

  .kind-chip {
    display: inline-flex;
    border-radius: 999px;
    padding: 0.2rem 0.65rem;
    font-size: 0.8rem;
    font-weight: 700;
    background: var(--accent-soft);
    color: var(--accent);
  }

  .status-chip {
    display: inline-flex;
    border-radius: 999px;
    padding: 0.2rem 0.65rem;
    font-size: 0.8rem;
    font-weight: 700;
    background: var(--bg);
    color: var(--text);
  }

  .status-published {
    background: #e7f5eb;
    color: #14532d;
  }

  .status-review,
  .status-draft {
    background: #fff1cf;
    color: #8a6116;
  }

  .status-archived {
    background: #eceff3;
    color: #52606d;
  }

  .row-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .row-actions a {
    color: var(--accent);
    font-weight: 700;
    text-decoration: none;
  }

  .row-actions a:hover {
    text-decoration: underline;
  }
</style>
