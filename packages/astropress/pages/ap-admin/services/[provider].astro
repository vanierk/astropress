---
import { safeAdminUserName } from "astropress";
import AdminLayout from "@astropress-diy/astropress/components/AdminLayout.astro";
import {
	getAstropressService,
	type ServiceProvider,
} from "@astropress-diy/astropress/services-config";
import { getPageT, requiresAccess, resolveAdminLocale } from "astropress";

// Matches the services hub's own guard (services.astro): leaf service pages
// must enforce the same services:manage ABAC action. The previous inline
// isAuthUserAdmin check set a 403 status with no early return, so the panel
// (and the iframe pointed at service.adminPath) still rendered regardless.
const guard = await requiresAccess(Astro, "services:manage");
if (guard) return guard;
const adminUser = Astro.locals.adminUser;
if (!adminUser) return Astro.redirect("/ap-admin/login");

const { provider } = Astro.params as { provider: string };
const service = getAstropressService(provider as ServiceProvider);
const t = getPageT(resolveAdminLocale(Astro));

if (!service) {
	Astro.response.status = 404;
}
---

{!service ? (
  <AdminLayout
    title={t("services.notConfiguredTitle")}
    heading={t("services.notConfiguredTitle")}
    currentPath="/ap-admin/services"
    description={t("services.notConfiguredDescription")}
    userName={safeAdminUserName(adminUser)}
  >
    <section class="panel">
      <p class="admin-kicker">{t("services.notFound")}</p>
      <h2>{t("services.notConfiguredTitle")}</h2>
      <p>
        {t("services.notRegisteredBefore")} <code>{provider}</code>.
        {t("services.notRegisteredAfter")} <code>registerAstropressService(&#123;&#125;)</code> {t("services.notRegisteredEnd")}
      </p>
      <a href="/ap-admin/services" class="admin-button-ghost">{t("services.backToServices")}</a>
    </section>
  </AdminLayout>
) : (
  <AdminLayout
    title={service.label}
    heading={service.label}
    currentPath="/ap-admin/services"
    description={service.description}
    userName={safeAdminUserName(adminUser)}
  >
    <div class="service-host">
      <div class="service-host__toolbar">
        <a href="/ap-admin/services" class="admin-button-ghost small">{t("services.allServices")}</a>
        <span class="service-host__label">{service.description}</span>
        <a
          href={service.adminPath + "/"}
          target="_blank"
          rel="noreferrer"
          class="admin-button-ghost small"
        >
          {t("services.openInNewTab")}
        </a>
      </div>
      <iframe
        class="service-host__frame"
        src={service.adminPath + "/"}
        title={service.label + " " + t("services.adminFrameTitle")}
        allow="clipboard-read; clipboard-write"
      ></iframe>
    </div>
  </AdminLayout>
)}

<style>
  .service-host {
    display: grid;
    grid-template-rows: auto 1fr;
    height: calc(100vh - 6rem);
    gap: 0.6rem;
  }

  .service-host__toolbar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .service-host__label {
    color: var(--muted);
    font-size: 0.9rem;
    flex: 1;
  }

  .service-host__frame {
    width: 100%;
    height: 100%;
    border: 1px solid var(--line);
    border-radius: 0.7rem;
    background: var(--panel);
  }

  /* Expand the admin main so the iframe fills the viewport */
  :global(#admin-main) {
    display: grid;
    grid-template-rows: 1fr;
    overflow: hidden;
  }

  @media (max-width: 600px) {
    .service-host {
      height: auto;
      min-height: 60vh;
    }

    .service-host__toolbar {
      flex-direction: column;
      align-items: stretch;
      gap: 0.5rem;
    }

    .service-host__toolbar a {
      text-align: center;
    }

    .service-host__frame {
      min-height: 55vh;
    }

    :global(#admin-main) {
      overflow: auto;
    }
  }
</style>
