---
import { safeAdminUserName } from "astropress";
import AdminLayout from "@astropress-diy/astropress/components/AdminLayout.astro";
import AuditTrail from "@astropress-diy/astropress/components/AuditTrail.astro";
import CsrfInput from "@astropress-diy/astropress/components/CsrfInput.astro";
import {
	buildPostEditorPageModel,
	getAdminLocalePair,
	getPageT,
	getSeededAdminContentType,
	isAuthUserAdmin,
	requiresAccess,
	resolveAdminLocale,
} from "astropress";
import { peekCmsConfig } from "../../../src/config.js";

export const prerender = false;

// #107: enforce the declared post permission at the route boundary, matching
// the revisions + preview siblings (which already guard on posts:edit).
const guard = await requiresAccess(Astro, "posts:edit");
if (guard) return guard;

const adminUser = Astro.locals.adminUser;
const t = getPageT(resolveAdminLocale(Astro));
const slug = Astro.params.slug ?? "";
const model = await buildPostEditorPageModel(Astro.locals, slug);
const {
	pageRecord,
	authors,
	categories,
	tags,
	auditEvents,
	englishOwnerRecord,
	localizedRouteRecord,
	effectiveTranslationState,
} = model.data;
const wasSaved = Astro.url.searchParams.get("saved") === "1";
const errorMessage =
	Astro.url.searchParams.get("error") === "1" ? Astro.url.searchParams.get("message") : "";
const contentType = pageRecord ? getSeededAdminContentType(pageRecord) : "post";
const isPage = contentType === "page";
const editLabel = isPage ? t("postEditor.editPage") : t("postEditor.editPost");
const listPath = contentType === "page" ? "/ap-admin/pages" : "/ap-admin/posts";
const localePair = pageRecord ? getAdminLocalePair(pageRecord.legacyUrl) : null;
const englishEditorHref = englishOwnerRecord
	? `/ap-admin/posts/${englishOwnerRecord.slug}`
	: undefined;
const localizedEditorHref = localizedRouteRecord
	? `/ap-admin/route-pages${localizedRouteRecord.path}`
	: undefined;
const publicHref = pageRecord?.legacyUrl || "/";
const publicStatus = pageRecord?.status ?? "published";

// Resolve the registered ContentTypeDefinition for this record's templateKey, if any.
// Used to auto-generate custom field inputs in the editor.
const registeredContentTypes = peekCmsConfig()?.contentTypes ?? [];
const registeredContentType = pageRecord
	? (registeredContentTypes.find((ct) => ct.key === pageRecord.templateKey) ?? null)
	: null;
const customFields = registeredContentType?.fields ?? [];
const currentMetadata = (pageRecord?.metadata ?? {}) as Record<string, unknown>;

const isAdmin = !!adminUser && isAuthUserAdmin(adminUser);
if (!isAdmin && contentType === "page") {
	Astro.response.status = 403;
}

if (model.status === "not_found") {
	Astro.response.status = 404;
}
---

{pageRecord && !(!isAdmin && contentType === "page") ? (
  <AdminLayout
    title={`${editLabel} | ${pageRecord.title}`}
    heading={editLabel}
    currentPath={listPath}
    description={isPage ? t("postEditor.descPage") : t("postEditor.descPost")}
    userName={safeAdminUserName(adminUser)}
  >
    <nav class="breadcrumb" aria-label="breadcrumb">
      <a href={listPath}>{isPage ? t("postEditor.crumbPages") : t("postEditor.crumbPosts")}</a>
      <span aria-hidden="true"> / </span>
      <span aria-current="page">{pageRecord.title || slug}</span>
    </nav>
    {model.warnings.length > 0 && <ap-notice type="info">{t("postEditor.partialResults")}</ap-notice>}
    <div class="toolbar">
      <a href={listPath} class="admin-button-secondary">{isPage ? t("postEditor.backToPages") : t("postEditor.backToPosts")}</a>
      <a href={publicHref} target="_blank" rel="noreferrer" class="admin-button-ghost">{isPage ? t("postEditor.openPublicPage") : t("postEditor.openPublicPost")}</a>
      <a href={`/ap-admin/posts/${pageRecord.slug}/revisions`} class="admin-button-ghost">{t("postEditor.viewRevisions")}</a>
    </div>
    {wasSaved && <ap-notice type="success" dismiss-after="6000">{t("postEditor.savedSuccess")}</ap-notice>}
    {errorMessage && <ap-notice type="error">{errorMessage}</ap-notice>}

    <ap-html-editor>
    <ap-pending-form>
    <form method="post" action="/ap-admin/actions/content-save" class="edit-form">
      <CsrfInput token={Astro.locals.csrfToken} />
      <input type="hidden" name="slug" value={pageRecord.slug} />
      <input type="hidden" name="lastKnownUpdatedAt" value={pageRecord.updatedAt} />

      {/* Panel 1: Publish */}
      <section class="panel">
        <div class="section-header">
          <div>
            <h2>{t("postEditor.sectionPublish")}</h2>
            <p>{t("postEditor.sectionPublishDesc")}</p>
          </div>
        </div>
        <p class="field-note">{t("postEditor.publicRouteLabel")} <a href={publicHref} target="_blank" rel="noreferrer">{publicHref}</a> · {t("postEditor.currentStatusLabel")} <strong>{publicStatus}</strong></p>
        <label class="admin-field">
          <span>{t("common.title")}</span>
          <input aria-label={t("postEditor.titleAria")} type="text" name="title" value={pageRecord.title} class="admin-input" />
        </label>
        <label class="admin-field">
          <span>{t("common.status")}</span>
          <select aria-label={t("postEditor.statusAria")} name="status" class="admin-select">
            <option value="published" selected={pageRecord.status === "published"}>{t("common.published")}</option>
            <option value="review" selected={pageRecord.status === "review"}>{t("common.inReview")}</option>
            <option value="draft" selected={pageRecord.status === "draft"}>{t("common.draft")}</option>
            <option value="archived" selected={pageRecord.status === "archived"}>{t("common.archived")}</option>
          </select>
        </label>
        <label class="admin-field">
          <span>{t("postEditor.scheduledPublishTime")}</span>
          <input
            aria-label={t("postEditor.scheduledPublishTimeAria")}
            type="datetime-local"
            name="scheduledAt"
            value={pageRecord.scheduledAt ? new Date(pageRecord.scheduledAt).toISOString().slice(0, 16) : ""}
            class="admin-input"
          />
        </label>
        <label class="admin-field">
          <span>{t("postEditor.slug")}</span>
          <input type="text" aria-label={t("postEditor.slug")} value={pageRecord.slug} readonly tabindex="-1" class="admin-input" />
        </label>
      </section>

      <section class="panel">
        <div class="section-header">
          <div>
            <h2>{t("postEditor.sectionTaxonomy")}</h2>
            <p>{t("postEditor.sectionTaxonomyDesc")}</p>
          </div>
        </div>
        <div class="taxonomy-columns">
          <fieldset>
            <legend>{t("postEditor.authors")}</legend>
            {authors.length > 0 ? authors.map((author) => (
              <label class="checkbox-row">
                <input type="checkbox" name="authorIds" value={author.id} checked={pageRecord.authorIds?.includes(author.id)} />
                <span>{author.name}</span>
              </label>
            )) : <p class="field-note">{t("postEditor.noAuthors")}</p>}
          </fieldset>
          <fieldset>
            <legend>{t("postEditor.categories")}</legend>
            {categories.length > 0 ? categories.map((term) => (
              <label class="checkbox-row">
                <input type="checkbox" name="categoryIds" value={term.id} checked={pageRecord.categoryIds?.includes(term.id)} />
                <span>{term.name}</span>
              </label>
            )) : <p class="field-note">{t("postEditor.noCategories")}</p>}
          </fieldset>
          <fieldset>
            <legend>{t("postEditor.tags")}</legend>
            {tags.length > 0 ? tags.map((term) => (
              <label class="checkbox-row">
                <input type="checkbox" name="tagIds" value={term.id} checked={pageRecord.tagIds?.includes(term.id)} />
                <span>{term.name}</span>
              </label>
            )) : <p class="field-note">{t("postEditor.noTags")}</p>}
          </fieldset>
        </div>
      </section>

      {/* Panel 2: Body */}
      <section class="panel">
        <div class="section-header">
          <div>
            <h2>{t("postEditor.sectionBody")}</h2>
            <p>{t("postEditor.sectionBodyDesc")}</p>
          </div>
        </div>
        <p class="field-note">{t("postEditor.bodyFieldNote")}</p>
        <div role="toolbar" aria-label={t("postEditor.formatBodyAria")} class="body-toolbar">
          <button type="button" class="toolbar-btn" data-cmd="bold" aria-label={t("postEditor.boldAria")}><strong>B</strong></button>
          <button type="button" class="toolbar-btn" data-cmd="italic" aria-label={t("postEditor.italicAria")}><em>I</em></button>
          <button type="button" class="toolbar-btn" data-cmd="insertUnorderedList" aria-label={t("postEditor.bulletListAria")}>&#8226; {t("postEditor.listLabel")}</button>
          <button type="button" class="toolbar-btn" data-cmd="createLink" aria-label={t("postEditor.insertLink")}>{t("postEditor.linkLabel")}</button>
          <button type="button" class="toolbar-btn insert-media-btn" aria-label={t("postEditor.openMediaLibrary")}>{t("postEditor.openMediaLibrary")}</button>
        </div>
        <label class="admin-field">
          <span>{t("postEditor.bodyHtml")}</span>
          <textarea aria-label={t("postEditor.bodyHtml")} name="body" rows="14" class="admin-textarea code-field body-editor" data-body-editor>{pageRecord.body}</textarea>
        </label>
      </section>

      {/* Media library dialog */}
      <dialog class="media-dialog" aria-labelledby="media-library-title" id="media-library-dialog">
        <div class="media-dialog-inner">
          <h2 id="media-library-title">{t("postEditor.mediaLibraryTitle")}</h2>
          <p class="field-note">{t("postEditor.mediaLibraryDesc")}</p>
          <div class="media-grid" id="media-grid-placeholder">
            <p class="field-note">{t("postEditor.mediaEmpty")}</p>
          </div>
          <div class="media-dialog-actions">
            <button type="button" class="admin-button-ghost" id="media-dialog-close">{t("postEditor.close")}</button>
          </div>
        </div>
      </dialog>

      <section class="panel">
        <div class="section-header">
          <div>
            <h2>{t("postEditor.sectionPreview")}</h2>
            <p>{t("postEditor.sectionPreviewDesc")}</p>
          </div>
        </div>
        <p class="field-note">{t("postEditor.sectionPreviewDesc")}</p>
        <div class="preview-frame">
          <iframe
            title={t("postEditor.previewFrameTitle")}
            sandbox=""
            srcdoc={`<!doctype html><html lang="en"><head><meta charset="utf-8"><style>body{font-family:Georgia,serif;padding:1rem;line-height:1.6;color:#17212c}</style></head><body>${pageRecord.body}</body></html>`}
          />
        </div>
      </section>

      {/* Panel 3: Excerpt */}
      <section class="panel">
        <div class="section-header">
          <div>
            <h2>{t("postEditor.sectionExcerpt")}</h2>
            <p>{t("postEditor.sectionExcerptDesc")}</p>
          </div>
        </div>
        <label class="admin-field">
          <span>{t("postEditor.summaryExcerpt")}</span>
          <textarea aria-label={t("postEditor.excerptAria")} rows="4" name="excerpt" placeholder={t("postEditor.excerptPlaceholder")} class="admin-textarea">{("excerpt" in pageRecord ? pageRecord.excerpt : "") || pageRecord.summary}</textarea>
        </label>
      </section>

      <section class="panel">
        <div class="section-header">
          <div>
            <h2>{t("postEditor.sectionRevisionNote")}</h2>
            <p>{t("postEditor.sectionRevisionNoteDesc")}</p>
          </div>
        </div>
        <label class="admin-field">
          <span>{t("postEditor.changeSummary")}</span>
          <textarea aria-label={t("postEditor.revisionNoteAria")} rows="3" name="revisionNote" placeholder={t("postEditor.revisionNotePlaceholder")} class="admin-textarea" />
        </label>
      </section>

      {/* Panel 4: SEO */}
      <section class="panel">
        <div class="section-header">
          <div>
            <h2>{t("postEditor.sectionSeo")}</h2>
            <p>{t("postEditor.sectionSeoDesc")}</p>
          </div>
        </div>
        <label class="admin-field">
          <span>{t("postEditor.seoTitle")}</span>
          <input aria-label={t("postEditor.seoTitleAria")} type="text" name="seoTitle" value={pageRecord.seoTitle || pageRecord.title} class="admin-input" />
        </label>
        <label class="admin-field">
          <span>{t("postEditor.metaDescription")}</span>
          <textarea aria-label={t("postEditor.metaDescriptionAria")} rows="3" name="metaDescription" class="admin-textarea">{pageRecord.metaDescription || pageRecord.summary}</textarea>
        </label>
      </section>

      {/* Panel 5: OG / Social */}
      <section class="panel">
        <div class="section-header">
          <div>
            <h2>{t("postEditor.sectionOg")}</h2>
            <p>{t("postEditor.sectionOgDesc")}</p>
          </div>
        </div>
        <label class="admin-field">
          <span>{t("postEditor.ogTitle")}</span>
          <input aria-label={t("postEditor.ogTitleAria")} type="text" name="ogTitle" value={pageRecord.ogTitle || ""} placeholder={t("postEditor.ogTitlePlaceholder")} class="admin-input" />
        </label>
        <label class="admin-field">
          <span>{t("postEditor.ogDescription")}</span>
          <textarea aria-label={t("postEditor.ogDescriptionAria")} rows="3" name="ogDescription" placeholder={t("postEditor.ogDescriptionPlaceholder")} class="admin-textarea">{pageRecord.ogDescription || ""}</textarea>
        </label>
        <label class="admin-field">
          <span>{t("postEditor.ogImage")}</span>
          <input aria-label={t("postEditor.ogImageAria")} type="url" name="ogImage" value={pageRecord.ogImage || ""} placeholder={t("postEditor.ogImagePlaceholder")} class="admin-input" />
        </label>
      </section>

      {/* Panel 6: Canonical & Robots */}
      <section class="panel">
        <div class="section-header">
          <div>
            <h2>{t("postEditor.sectionCanonical")}</h2>
            <p>{t("postEditor.sectionCanonicalDesc")}</p>
          </div>
        </div>
        <label class="admin-field">
          <span>{t("postEditor.canonicalOverride")}</span>
          <input aria-label={t("postEditor.canonicalAria")} type="url" name="canonicalUrlOverride" value={pageRecord.canonicalUrlOverride || ""} placeholder={t("postEditor.canonicalPlaceholder")} class="admin-input" />
        </label>
        <label class="admin-field">
          <span>{t("postEditor.robotsDirective")}</span>
          <select aria-label={t("postEditor.robotsAria")} name="robotsDirective" class="admin-select">
            <option value="">{t("postEditor.robotsDefault")}</option>
            <option value="noindex" selected={pageRecord.robotsDirective === "noindex"}>noindex</option>
            <option value="nofollow" selected={pageRecord.robotsDirective === "nofollow"}>nofollow</option>
            <option value="noindex, nofollow" selected={pageRecord.robotsDirective === "noindex, nofollow"}>noindex, nofollow</option>
          </select>
        </label>
      </section>

      {/* Panel 7: Locale & Translations */}
      <section class="panel">
        <div class="section-header">
          <div>
            <h2>{t("postEditor.sectionLocale")}</h2>
            <p>{t("postEditor.sectionLocaleDesc")}</p>
          </div>
        </div>
        <p class="field-note">{t("postEditor.currentLocaleLabel")} <strong>{localePair?.currentLocale === "es" ? "es" : "en"}</strong></p>
        {localePair ? (
          <>
            <div class="locale-links">
              {englishEditorHref && <a href={englishEditorHref} class="admin-button-ghost small">{t("postEditor.editEnglishVariant")}</a>}
              {localizedEditorHref && <a href={localizedEditorHref} class="admin-button-ghost small">{t("postEditor.editSpanishVariant")}</a>}
              <a href="/ap-admin/translations" class="admin-button-ghost small">{t("postEditor.openTranslationCoverage")}</a>
            </div>
            {isAdmin && localePair.localizedRoute ? (
              <div class="translation-inline-form">
                <input type="hidden" name="route" value={localePair.localizedRoute} />
                <input type="hidden" name="returnPath" value={`/ap-admin/posts/${pageRecord.slug}`} />
                <label class="admin-field">
                  <span>{t("postEditor.translationState")}</span>
                  <select name="state" aria-label={t("postEditor.translationState")} class="admin-select">
                    <option value="not_started" selected={effectiveTranslationState === "not_started"}>{t("postEditor.tsNotStarted")}</option>
                    <option value="partial" selected={effectiveTranslationState === "partial"}>{t("postEditor.tsPartial")}</option>
                    <option value="fallback_en" selected={effectiveTranslationState === "fallback_en"}>{t("postEditor.tsFallbackEn")}</option>
                    <option value="translated" selected={effectiveTranslationState === "translated"}>{t("postEditor.tsTranslated")}</option>
                    <option value="reviewed" selected={effectiveTranslationState === "reviewed"}>{t("postEditor.tsReviewed")}</option>
                    <option value="published" selected={effectiveTranslationState === "published"}>{t("common.published")}</option>
                  </select>
                </label>
                <button type="submit" formaction="/ap-admin/actions/translation-update" formmethod="post" class="admin-button small">{t("postEditor.updateTranslationState")}</button>
              </div>
            ) : (
              <p class="field-note">{t("postEditor.translationAdminsOnly")}</p>
            )}
          </>
        ) : (
          <p class="field-note">{isPage ? t("postEditor.noLocaleVariantPage") : t("postEditor.noLocaleVariantPost")}</p>
        )}
      </section>

      {/* Panel 8: Legacy Reference */}
      <section class="panel">
        <div class="section-header">
          <div>
            <h2>{t("postEditor.sectionLegacy")}</h2>
            <p>{t("postEditor.sectionLegacyDesc")}</p>
          </div>
        </div>
        <label class="admin-field">
          <span>{t("postEditor.legacyUrl")}</span>
          <input type="text" value={pageRecord.legacyUrl} readonly class="admin-input" />
        </label>
        <label class="admin-field">
          <span>{t("postEditor.sourceHtmlPath")}</span>
          <input type="text" value={pageRecord.sourceHtmlPath} readonly class="admin-input code-field" />
        </label>
        <p class="field-note">{t("postEditor.legacyNote")}</p>
      </section>

      {/* Panel: Custom fields — auto-generated from registered ContentTypeDefinition */}
      {customFields.length > 0 && (
        <section class="panel" data-ap-custom-fields>
          <div class="section-header">
            <div>
              <h2>{registeredContentType!.label} {t("postEditor.fieldsSuffix")}</h2>
              <p>{t("postEditor.customFieldsDesc")} <code>registerCms()</code>.</p>
            </div>
          </div>
          {customFields.map((field) => {
            const fieldName = `metadata.${field.name}`;
            const currentValue = currentMetadata[field.name];
            const labelText = `${field.label}${field.required ? " *" : ""}`;

            if (field.type === "boolean") {
              return (
                <label class="admin-field admin-field--checkbox">
                  <input
                    type="checkbox"
                    name={fieldName}
                    value="true"
                    checked={Boolean(currentValue)}
                  />
                  <span>{labelText}</span>
                </label>
              );
            }

            if (field.type === "select" && field.options) {
              return (
                <label class="admin-field">
                  <span>{labelText}</span>
                  <select name={fieldName} class="admin-input" required={field.required}>
                    <option value="">{t("postEditor.selectPlaceholder")}</option>
                    {field.options.map((opt) => (
                      <option value={opt} selected={currentValue === opt}>{opt}</option>
                    ))}
                  </select>
                </label>
              );
            }

            // Default: text input
            return (
              <label class="admin-field">
                <span>{labelText}</span>
                <input
                  type="text"
                  name={fieldName}
                  value={String(currentValue ?? "")}
                  class="admin-input"
                  required={field.required}
                />
              </label>
            );
          })}
        </section>
      )}

      <div class="form-actions">
        <button type="submit" class="admin-button">{t("postEditor.saveChanges")}</button>
        <a href={listPath} class="admin-button-ghost secondary-button">{t("postEditor.cancel")}</a>
      </div>
    </form>
    </ap-pending-form>

    {/* URL input dialog — replaces window.prompt() for the Insert Link toolbar action */}
    <dialog id="url-input-dialog" class="url-input-dialog" aria-labelledby="url-input-title">
      <div class="modal-content">
        <h2 id="url-input-title">{t("postEditor.insertLink")}</h2>
        <form id="url-input-form" method="dialog">
          <label class="admin-field">
            <span>{t("postEditor.urlLabel")}</span>
            <input id="url-input-field" type="url" name="url" placeholder="https://" class="admin-input" />
          </label>
          <div class="modal-actions">
            <button type="button" class="admin-button-ghost small" data-dialog-close>{t("postEditor.cancel")}</button>
            <button type="submit" class="admin-button small">{t("postEditor.insertLink")}</button>
          </div>
        </form>
      </div>
    </dialog>

    </ap-html-editor>

    <AuditTrail events={auditEvents.filter((event) => event.targetType === "content").slice(0, 5)} />

    <script>
      import "../../../web-components/html-editor";
      import "../../../web-components/pending-form";
    </script>
  </AdminLayout>
) : (
  <AdminLayout
    title={!isAdmin && isPage ? t("postEditor.forbidden") : t("postEditor.notFound")}
    heading={!isAdmin && isPage ? t("postEditor.forbidden") : t("postEditor.notFound")}
    currentPath="/ap-admin/posts"
    description={!isAdmin && isPage ? t("postEditor.forbiddenDesc") : t("postEditor.notFoundDesc")}
    userName={safeAdminUserName(adminUser)}
  >
    <section class="panel">
      <p>{!isAdmin && isPage ? t("postEditor.forbiddenBody") : t("postEditor.notFoundDesc")}</p>
    </section>
  </AdminLayout>
)}

<style>
  .edit-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  input[readonly],
  textarea[readonly] {
    background: var(--bg);
    color: var(--muted);
    cursor: not-allowed;
  }

  .field-note {
    margin: -0.75rem 0 1rem 0;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .locale-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .translation-inline-form {
    display: grid;
    gap: 0.75rem;
  }

  .translation-inline-form label {
    margin-bottom: 0;
  }

  .translation-inline-form button {
    justify-self: start;
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .toolbar a,
  .locale-links a,
  .field-note a {
    color: var(--accent);
    font-weight: 700;
    text-decoration: none;
  }

  .toolbar a:hover,
  .locale-links a:hover,
  .field-note a:hover {
    text-decoration: underline;
  }

  .preview-frame {
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: color-mix(in srgb, var(--panel) 95%, var(--accent-soft) 5%);
    overflow: hidden;
  }

  .preview-frame iframe {
    display: block;
    width: 100%;
    min-height: 18rem;
    border: 0;
    background: transparent;
  }

  .taxonomy-columns {
    display: grid;
    gap: 1rem;
  }

  fieldset {
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    padding: 0.9rem 1rem 1rem;
  }

  legend {
    padding: 0 0.3rem;
    font-weight: 700;
  }

  .checkbox-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.55rem;
  }

  .checkbox-row input {
    width: auto;
    margin: 0;
  }

  .form-actions {
    display: flex;
    gap: 0.75rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .code-field {
    font-family: "Monaco", monospace;
    font-size: 0.85rem;
  }

  .body-toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0.5rem;
    padding: 0.4rem 0.5rem;
    border: 1px solid var(--line);
    border-bottom: none;
    border-radius: 0.65rem 0.65rem 0 0;
    background: color-mix(in srgb, var(--panel) 90%, var(--accent-soft) 10%);
  }

  .toolbar-btn {
    border: 1px solid var(--line);
    border-radius: 0.4rem;
