---
import AdminLayout from "@astropress-diy/astropress/components/AdminLayout.astro";
import CsrfInput from "@astropress-diy/astropress/components/CsrfInput.astro";
import { getPageT, requiresAccess, resolveAdminLocale } from "astropress";

// #107: the new-post editor must require posts:create; it was previously
// reachable by any authenticated subject and crashed on anonymous render.
const guard = await requiresAccess(Astro, "posts:create");
if (guard) return guard;
const adminUser = Astro.locals.adminUser;
if (!adminUser) return Astro.redirect("/ap-admin/login");
const t = getPageT(resolveAdminLocale(Astro));
const errorMessage =
	Astro.url.searchParams.get("error") === "1" ? Astro.url.searchParams.get("message") : "";
---

<AdminLayout
  title={t("postsNew.title")}
  heading={t("postsNew.title")}
  currentPath="/ap-admin/posts"
  description={t("postsNew.description")}
  userName={adminUser.name}
>
  {errorMessage && <p class="error-notice">{errorMessage}</p>}

  <form method="post" action="/ap-admin/actions/content-create" class="edit-form">
    <CsrfInput token={Astro.locals.csrfToken} />

    <section class="panel">
      <div class="section-header">
        <div>
          <h2>{t("postsNew.sectionGeneral")}</h2>
          <p>{t("postsNew.sectionGeneralDesc")}</p>
        </div>
      </div>
      <label class="admin-field">
        <span>{t("common.title")}</span>
        <input type="text" name="title" aria-label={t("postsNew.titleAria")} required class="admin-input" />
      </label>
      <label class="admin-field">
        <span>{t("postsNew.slug")}</span>
        <input type="text" name="slug" aria-label={t("postsNew.slug")} required class="admin-input" />
      </label>
      <label class="admin-field">
        <span>{t("postsNew.publicRoute")}</span>
        <input type="text" name="legacyUrl" aria-label={t("postsNew.publicRoute")} placeholder={t("postsNew.publicRoutePlaceholder")} class="admin-input" />
      </label>
      <label class="admin-field">
        <span>{t("common.status")}</span>
        <select name="status" aria-label={t("postsNew.statusAria")} class="admin-select">
          <option value="draft" selected>{t("common.draft")}</option>
          <option value="review">{t("common.inReview")}</option>
          <option value="published">{t("common.published")}</option>
        </select>
      </label>
    </section>

    <section class="panel">
      <div class="section-header">
        <div>
          <h2>{t("postsNew.sectionContent")}</h2>
          <p>{t("postsNew.sectionContentDesc")}</p>
        </div>
      </div>
      <label class="admin-field">
        <span>{t("postsNew.summary")}</span>
        <textarea name="summary" aria-label={t("postsNew.summaryAria")} rows="3" class="admin-textarea"></textarea>
      </label>
      <label class="admin-field">
        <span>{t("postsNew.bodyHtml")}</span>
        <textarea name="body" aria-label={t("postsNew.bodyHtml")} rows="12" class="admin-textarea code-field"></textarea>
      </label>
    </section>

    <section class="panel">
      <div class="section-header">
        <div>
          <h2>{t("postsNew.sectionSeo")}</h2>
          <p>{t("postsNew.sectionSeoDesc")}</p>
        </div>
      </div>
      <label class="admin-field">
        <span>{t("postsNew.seoTitle")}</span>
        <input type="text" name="seoTitle" aria-label={t("postsNew.seoTitleAria")} required class="admin-input" />
      </label>
      <label class="admin-field">
        <span>{t("postsNew.metaDescription")}</span>
        <textarea name="metaDescription" aria-label={t("postsNew.metaDescriptionAria")} rows="3" required class="admin-textarea"></textarea>
      </label>
    </section>

    <div class="form-actions">
      <button type="submit" class="admin-button">{t("postsNew.submit")}</button>
      <a href="/ap-admin/posts" class="admin-button-ghost secondary-button">{t("postsNew.cancel")}</a>
    </div>
  </form>
</AdminLayout>

<style>
  .code-field {
    font-family: monospace;
  }
</style>
