---
import AdminLayout from "@astropress-diy/astropress/components/AdminLayout.astro";
import AuditTrail from "@astropress-diy/astropress/components/AuditTrail.astro";
import CsrfInput from "@astropress-diy/astropress/components/CsrfInput.astro";
import {
	buildPostRevisionsPageModel,
	getPageT,
	requiresAccess,
	resolveAdminLocale,
} from "astropress";

export const prerender = false;

// #107: revisions can expose draft/historical content, so gate on posts:edit.
const guard = await requiresAccess(Astro, "posts:edit");
if (guard) return guard;
const adminUser = Astro.locals.adminUser;
if (!adminUser) return Astro.redirect("/ap-admin/login");
const adminLocale = resolveAdminLocale(Astro);
const t = getPageT(adminLocale);
const slug = Astro.params.slug ?? "";
const model = await buildPostRevisionsPageModel(Astro.locals, slug);
const { pageRecord, revisions, auditEvents, authors, categories, tags } = model.data;
const wasRestored = Astro.url.searchParams.get("restored") === "1";
const errorMessage =
	Astro.url.searchParams.get("error") === "1" ? Astro.url.searchParams.get("message") : "";

const authorNamesById = new Map(authors.map((author) => [author.id, author.name]));
const categoryNamesById = new Map(categories.map((term) => [term.id, term.name]));
const tagNamesById = new Map(tags.map((term) => [term.id, term.name]));

function joinAssignmentLabels(ids: number[] | undefined, labelsById: Map<number, string>) {
	if (!ids || ids.length === 0) {
		return "—";
	}

	const labels = ids
		.map((id) => labelsById.get(id))
		.filter((value): value is string => Boolean(value));
	return labels.length > 0 ? labels.join(", ") : "—";
}

if (model.status === "not_found") {
	Astro.response.status = 404;
}
---

{pageRecord && revisions ? (
  <AdminLayout
    title={`${t("revisions.title")} | ${pageRecord.title}`}
    heading={t("revisions.title")}
    currentPath="/ap-admin/posts"
    description={t("revisions.description")}
    userName={adminUser.name}
  >
    {model.warnings.length > 0 && <p class="notice">{t("revisions.partialResults")}</p>}
    <div class="toolbar">
      <a href={`/ap-admin/posts/${pageRecord.slug}`}>{t("revisions.returnToEdit")}</a>
    </div>
    {wasRestored && <p class="notice">{t("revisions.restoredSuccess")}</p>}
    {errorMessage && <p class="error-notice">{errorMessage}</p>}
    <section class="panel">
      <p><strong>{t("revisions.historyHeading")}</strong></p>
      <table aria-label={t("revisions.historyHeading")}>
        <thead>
          <tr>
            <th>{t("revisions.thSource")}</th>
            <th>{t("common.title")}</th>
            <th>{t("common.status")}</th>
            <th>{t("revisions.thScheduled")}</th>
            <th>{t("revisions.thSeoTitle")}</th>
            <th>{t("revisions.thAuthors")}</th>
            <th>{t("revisions.thCategories")}</th>
            <th>{t("revisions.thTags")}</th>
            <th>{t("revisions.thNote")}</th>
            <th>{t("revisions.thBy")}</th>
            <th>{t("revisions.thTimestamp")}</th>
            <th>{t("revisions.thAction")}</th>
          </tr>
        </thead>
        <tbody>
          {revisions.map((revision) => (
            <tr>
              <td>{revision.source}</td>
              <td>{revision.title}</td>
              <td>{revision.status}</td>
              <td>{revision.scheduledAt ? new Date(revision.scheduledAt).toLocaleString(adminLocale) : "—"}</td>
              <td>{revision.seoTitle}</td>
              <td>{joinAssignmentLabels(revision.authorIds, authorNamesById)}</td>
              <td>{joinAssignmentLabels(revision.categoryIds, categoryNamesById)}</td>
              <td>{joinAssignmentLabels(revision.tagIds, tagNamesById)}</td>
              <td>{revision.revisionNote || "—"}</td>
              <td>{revision.createdBy || "—"}</td>
              <td>{revision.createdAt}</td>
              <td>
                <form method="post" action="/ap-admin/actions/revision-restore" class="restore-form">
                  <CsrfInput token={Astro.locals.csrfToken} />
                  <input type="hidden" name="slug" value={slug} />
                  <input type="hidden" name="revisionId" value={revision.id} />
                  <button type="submit" class="restore-button">{t("revisions.restore")}</button>
                </form>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
    <AuditTrail events={auditEvents.filter((event) => event.targetType === "content").slice(0, 5)} />
  </AdminLayout>
) : (
  <AdminLayout
    title={t("revisions.notFound")}
    heading={t("revisions.notFound")}
    currentPath="/ap-admin/posts"
    description={t("revisions.notFoundDesc")}
    userName={adminUser.name}
  >
    <section class="panel">
      <p>{t("revisions.notFoundDesc")}</p>
    </section>
  </AdminLayout>
)}

<style>
  .restore-form {
    display: flex;
  }

  .restore-button {
    border: 0;
    border-radius: 0.65rem;
    padding: 0.55rem 0.8rem;
    background: var(--accent);
    color: white;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }
</style>
