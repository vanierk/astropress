---
import AdminLayout from "@astropress-diy/astropress/components/AdminLayout.astro";
import { getPageT, resolveAdminLocale } from "astropress";

const adminUser = Astro.locals.adminUser;
const t = getPageT(resolveAdminLocale(Astro));

Astro.response.status = 404;
---

<AdminLayout
  title={t("notFound.pageNotFound")}
  heading={t("notFound.pageNotFound")}
  currentPath=""
  description={t("notFound.description")}
  userName={adminUser?.name ?? ""}
>
  <div class="panel" style="padding: 2rem; text-align: center; margin-top: 2rem;">
    <p style="font-size: 3rem; margin: 0; line-height: 1;">404</p>
    <p>{t("notFound.body")}</p>
    <a href="/ap-admin" class="button">{t("notFound.backToDashboard")}</a>
  </div>
</AdminLayout>
