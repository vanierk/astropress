---
import AdminLayout from "@astropress-diy/astropress/components/AdminLayout.astro";
import { getPageT, requiresAccess, resolveAdminLocale } from "astropress";
import { validateEmbedUrl } from "../../src/admin-embed-url";

// #125 parity: the CMS panel maps to settings:edit in the nav; gate it on the
// same permission rather than allowing any authenticated session.
const guard = await requiresAccess(Astro, "settings:edit");
if (guard) return guard;
const adminUser = Astro.locals.adminUser;
const t = getPageT(resolveAdminLocale(Astro));

// Require authentication
if (!adminUser) {
	return Astro.redirect("/ap-admin/login?return=/ap-admin/cms", 302);
}

// Read CMS config from locals (set by the host app's local-runtime-modules)
const cmsConfig = (Astro.locals as Record<string, unknown>).cmsConfig as
	| {
			type: string;
			mode: "iframe" | "link";
			url: string;
			label?: string;
			iframeAllow?: string;
	  }
	| undefined;

if (!cmsConfig) {
	return Astro.redirect("/ap-admin", 302);
}

const cmsLabel =
	cmsConfig.label ?? cmsConfig.type.charAt(0).toUpperCase() + cmsConfig.type.slice(1);

// #109: never render an unvalidated URL into an iframe src / link href. Require
// https (http allowed only for localhost); a dangerous or malformed URL becomes
// a deliberate admin error rather than a script-executing href or hostile frame.
const embed = validateEmbedUrl(cmsConfig.url);
---

<AdminLayout
  title={cmsLabel}
  heading={cmsLabel}
  currentPath="/ap-admin/cms"
  description={`${t("cms.descriptionPrefix")} ${cmsLabel}`}
  userName={adminUser.name}
  hasCms={true}
>
  {!embed.ok ? (
    <section class="panel cms-link-panel" data-cms-invalid-url>
      <div class="section-header">
        <div>
          <p class="admin-kicker">{t("cms.kicker")}</p>
          <h2>{cmsLabel}</h2>
          <p class="error-notice">{t("cms.misconfiguredPrefix")} {embed.reason}</p>
          <p class="admin-note">{t("cms.setUrlPrefix")} <code>cmsConfig.url</code> {t("cms.setUrlSuffix")}</p>
        </div>
      </div>
    </section>
  ) : cmsConfig.mode === "iframe" ? (
    <div class="cms-frame-shell">
      <iframe
        src={embed.url}
        class="cms-frame"
        title={`${cmsLabel} ${t("cms.iframeTitleSuffix")}`}
        allow={cmsConfig.iframeAllow ?? "clipboard-write; fullscreen"}
        data-cms-type={cmsConfig.type}
      />
    </div>
  ) : (
    <section class="panel cms-link-panel">
      <div class="section-header">
        <div>
          <p class="admin-kicker">{t("cms.kicker")}</p>
          <h2>{cmsLabel}</h2>
          <p>{t("cms.separateServiceNotice")}</p>
        </div>
      </div>
      <div class="cms-link-actions">
        <a
          href={embed.url}
          target="_blank"
          rel="noopener noreferrer"
          class="admin-button"
          data-cms-open-link
        >
          {t("embedPanel.openPrefix")} {cmsLabel}
        </a>
        <p class="admin-note">
          {t("embedPanel.opensPrefix")} <code>{embed.url}</code> {t("embedPanel.opensSuffix")}
        </p>
      </div>
    </section>
  )}
</AdminLayout>

<style>
  .cms-frame-shell {
    position: fixed;
    top: 0;
    left: 17rem;
    right: 0;
    bottom: 0;
    /* Push below the topbar (~66px) */
    top: 66px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 0.8rem 0 0 0;
    overflow: hidden;
  }

  .cms-frame {
    width: 100%;
    height: 100%;
    border: none;
  }

  .cms-link-panel {
    max-width: 38rem;
    padding: 1.5rem;
  }

  .cms-link-actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: flex-start;
  }

  .cms-link-actions code {
    font-size: 0.88rem;
    color: var(--muted);
    background: var(--surface-subtle);
    padding: 0.15rem 0.4rem;
    border-radius: 0.35rem;
  }

  @media (max-width: 900px) {
    .cms-frame-shell {
      left: 0;
    }
  }
</style>
