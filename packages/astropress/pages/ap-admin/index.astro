---
import AdminLayout from "@astropress-diy/astropress/components/AdminLayout.astro";
import AuditTrail from "@astropress-diy/astropress/components/AuditTrail.astro";
import {
	buildAdminDashboardPageModel,
	getPageT,
	isAuthUserAdmin,
	resolveAdminLocale,
} from "astropress";

const adminUser = Astro.locals.adminUser;
const isAdmin = !!adminUser && isAuthUserAdmin(adminUser);
const model = await buildAdminDashboardPageModel(Astro.locals, adminUser);
const {
	comments,
	redirectRules,
	routePages,
	posts,
	pages,
	reviewPosts,
	scheduledPosts,
	recentAuditEvents,
	recentActivity,
	translationNeedsAttention,
	supportSurfaceLinks,
	latestDeployment,
} = model.data;
const adminLocale = resolveAdminLocale(Astro);
const t = getPageT(adminLocale);
const formatDateTime = (value: string | number | Date) =>
	new Date(value).toLocaleString(adminLocale);
const statusLabel = (status: string | null | undefined): string => {
	const key = status ?? "published";
	if (key === "draft") return t("common.draft");
	if (key === "published") return t("common.published");
	if (key === "scheduled") return t("common.scheduled");
	if (key === "review") return t("common.statusReview");
	if (key === "pending") return t("common.statusPending");
	if (key === "archived") return t("common.archived");
	return key;
};
const kindLabel = (kind: string | null | undefined): string => {
	if (kind === "post") return t("common.kindPost");
	if (kind === "page") return t("common.kindPage");
	if (kind === "routePage" || kind === "route-page") return t("common.kindRoutePage");
	return kind ?? "";
};
const deploymentSucceeded = latestDeployment?.action === "deployment.trigger";
const deploymentLabel = !latestDeployment
	? t("dashboard.deployNoRecord")
	: deploymentSucceeded
		? t("dashboard.deployTriggered")
		: t("dashboard.deployFailed");
---

<AdminLayout
  title={t("dashboard.pageTitle")}
  heading={t("dashboard.pageTitle")}
  currentPath="/ap-admin"
  description={isAdmin
    ? t("dashboard.description")
    : t("dashboard.descriptionEditor")}
  userName={adminUser?.name ?? ""}
>
  {model.warnings.length > 0 && <p class="notice">{t("dashboard.partialResults")}</p>}
  <div class="stats-grid">
    <section class="panel stat stat-card">
      <span class="stat-label">{t("dashboard.publishedPosts")}</span>
      <strong>{posts.filter((record) => (record.status ?? "published") === "published").length}</strong>
      <p>{t("dashboard.publishedPostsDesc")}</p>
    </section>
    {isAdmin ? (
      <section class="panel stat stat-card">
        <span class="stat-label">{t("dashboard.publicPages")}</span>
        <strong>{pages.length + routePages.length}</strong>
        <p>{t("dashboard.publicPagesDesc")}</p>
      </section>
    ) : (
      <section class="panel stat stat-card">
        <span class="stat-label">{t("dashboard.pendingComments")}</span>
        <strong>{comments.filter((comment) => comment.status === "pending").length}</strong>
        <p>{t("dashboard.pendingCommentsDesc")}</p>
      </section>
    )}
    <section class="panel stat stat-card">
      <span class="stat-label">{t("common.needsReview")}</span>
      <strong>{reviewPosts.length}</strong>
      <p>{t("dashboard.needsReviewDesc")}</p>
    </section>
    <section class="panel stat stat-card">
      <span class="stat-label">{t("dashboard.scheduledPosts")}</span>
      <strong>{scheduledPosts.length}</strong>
      <p>{t("dashboard.scheduledPostsDesc")}</p>
    </section>
    {isAdmin && (
      <>
        <section class="panel stat stat-card">
          <span class="stat-label">{t("dashboard.redirectRules")}</span>
          <strong>{redirectRules.length}</strong>
          <p>{t("dashboard.redirectRulesDesc")}</p>
        </section>
        <section class="panel stat stat-card">
          <span class="stat-label">{t("dashboard.translationFollowup")}</span>
          <strong>{translationNeedsAttention}</strong>
          <p>{t("dashboard.translationFollowupDesc")}</p>
        </section>
      </>
    )}
  </div>

  <div class="dashboard-layout">
    <section class="panel dashboard-panel action-panel">
      <div class="section-header">
        <div>
          <p class="admin-kicker">{t("dashboard.create")}</p>
          <h2>{t("dashboard.startNewWork")}</h2>
          <p>{t("dashboard.startNewWorkDesc")}</p>
        </div>
      </div>
      <div class="action-grid compact">
        <a href="/ap-admin/posts/new" class="admin-button">{t("dashboard.newPost")}</a>
        {isAdmin && <a href="/ap-admin/pages/new" class="admin-button">{t("dashboard.newPage")}</a>}
        {isAdmin && <a href="/ap-admin/authors" class="admin-button-ghost">{t("dashboard.newAuthor")}</a>}
        {isAdmin && <a href="/ap-admin/users" class="admin-button-ghost">{t("dashboard.newUser")}</a>}
      </div>
    </section>
    {isAdmin && (
      <section class="panel dashboard-panel support-panel">
        <div class="section-header">
          <div>
            <h2>{t("dashboard.supportSurfaces")}</h2>
            <p>{t("dashboard.supportSurfacesDesc")}</p>
          </div>
        </div>
        <div class="support-grid">
          {supportSurfaceLinks.map((entry) => (
            <a href={entry.href} class="support-card">
              <strong>{t(entry.labelKey as never)}</strong>
              <span>{entry.count}</span>
              <small>{t(entry.helperKey as never)}</small>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>

  <div class="dashboard-columns">
    <section class="panel dashboard-panel">
      <div class="section-header">
        <div>
          <p class="admin-kicker">{t("dashboard.queue")}</p>
          <h2>{t("dashboard.scheduledSoon")}</h2>
          <p>{t("dashboard.scheduledSoonDesc")}</p>
        </div>
        <a href="/ap-admin/posts?workflow=scheduled" class="admin-button-ghost small">{t("dashboard.viewScheduled")}</a>
      </div>
      {scheduledPosts.length > 0 ? (
        <ul class="queue-list">
          {scheduledPosts.map((record) => (
            <li>
              <div class="queue-copy">
                <strong>{record.title}</strong>
                <span>{record.scheduledAt ? formatDateTime(record.scheduledAt) : t("common.unscheduled")}</span>
              </div>
              <a href={`/ap-admin/posts/${record.slug}`} class="admin-button-ghost small">{t("dashboard.open")}</a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty-copy">{t("dashboard.noFutureScheduled")}</p>
      )}
    </section>
    <section class="panel dashboard-panel">
      <div class="section-header">
        <div>
          <p class="admin-kicker">{t("dashboard.queue")}</p>
          <h2>{isAdmin ? t("dashboard.postReviewQueue") : t("dashboard.editorialQueue")}</h2>
          <p>{t("dashboard.postReviewQueueDesc")}</p>
        </div>
        <a href="/ap-admin/posts?workflow=review-needed" class="admin-button-ghost small">{t("common.openQueue")}</a>
      </div>
      {reviewPosts.length > 0 ? (
        <ul class="queue-list">
          {reviewPosts.slice(0, 6).map((record) => (
            <li>
              <div class="queue-copy">
                <strong>{record.title}</strong>
                <span>{statusLabel(record.status)}</span>
              </div>
              <a href={`/ap-admin/posts/${record.slug}`} class="admin-button-ghost small">{t("dashboard.review")}</a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty-copy">{t("dashboard.nothingWaiting")}</p>
      )}
    </section>
    <section class="panel dashboard-panel wide-panel">
      <div class="section-header">
        <div>
          <p class="admin-kicker">{t("dashboard.recentActivity")}</p>
          <h2>{t("dashboard.recentlyUpdated")}</h2>
          <p>{t("dashboard.recentlyUpdatedDesc")}</p>
        </div>
      </div>
      <ul class="queue-list">
        {recentActivity.map((record) => (
          <li>
            <div class="queue-copy">
              <strong>{record.title}</strong>
              <span>{kindLabel(record.kind)} · {record.updatedAt ? formatDateTime(record.updatedAt) : t("common.unknownUpdateTime")}</span>
            </div>
            <a href={record.editHref} class="admin-button-ghost small">{t("dashboard.open")}</a>
          </li>
        ))}
      </ul>
    </section>
  </div>

  {isAdmin && (
    <section class="panel dashboard-panel deployment-panel">
      <div class="section-header">
        <div>
          <p class="admin-kicker">{t("dashboard.publish")}</p>
          <h2>{t("dashboard.latestDeployment")}</h2>
          <p>{t("dashboard.latestDeploymentDesc")}</p>
        </div>
      </div>
      {latestDeployment ? (
        <div class={`deployment-status deployment-status--${deploymentSucceeded ? "ok" : "fail"}`}>
          <span class="deployment-badge">{deploymentLabel}</span>
          <div class="deployment-meta">
            <strong>{latestDeployment.summary}</strong>
            <span>
              {formatDateTime(latestDeployment.createdAt)} ·
              {" "}{t("dashboard.deployBy")} {latestDeployment.actorEmail}
            </span>
          </div>
        </div>
      ) : (
        <p class="empty-copy">{t("dashboard.noPublishYet")}</p>
      )}
    </section>
  )}

  <AuditTrail events={recentAuditEvents} />
</AdminLayout>

<style>
  h2 {
    margin-top: 0;
    margin-bottom: 0.7rem;
    font-size: 1.05rem;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 0.85rem;
  }

  .dashboard-layout,
  .dashboard-columns {
    display: grid;
    gap: 1rem;
    margin-top: 1rem;
  }

  .dashboard-layout {
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.9fr);
    align-items: start;
  }

  .dashboard-columns {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
  }

  .dashboard-panel {
    padding: 1.1rem;
  }

  .wide-panel {
    grid-column: 1 / -1;
  }

  .stat-card {
    gap: 0.4rem;
    align-items: flex-start;
  }

  .stat-label {
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    font-weight: 700;
  }

  .stat-card p {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.45;
  }

  .stat-card strong {
    font-size: clamp(1.7rem, 2vw, 2.15rem);
    line-height: 1;
  }

  .action-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .action-grid.compact {
    gap: 0.65rem;
    align-items: center;
  }

  .action-grid.compact > a {
    min-width: 9rem;
    justify-content: center;
  }

  .queue-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.8rem;
  }

  .queue-list li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    border-bottom: 1px solid var(--line);
    padding-bottom: 0.8rem;
  }

  .queue-list li:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .queue-copy {
    display: grid;
    gap: 0.2rem;
  }

  .queue-copy strong {
    font-size: 0.96rem;
  }

  .queue-copy span,
  .empty-copy {
    color: var(--muted);
    font-size: 0.92rem;
  }

  .support-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.7rem;
  }

  .support-card {
    display: grid;
    gap: 0.28rem;
    padding: 0.95rem;
    border-radius: 0.95rem;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--panel) 94%, var(--accent-soft) 6%);
    color: inherit;
    text-decoration: none;
  }

  .support-card span {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--accent);
  }

  .support-card small {
    color: var(--muted);
    line-height: 1.45;
  }

  .deployment-panel {
    margin-top: 1rem;
  }

  .deployment-status {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.85rem 1rem;
    border-radius: 0.7rem;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--panel) 92%, transparent);
  }

  .deployment-status--ok {
    border-color: color-mix(in srgb, #16a34a 50%, var(--line));
    background: color-mix(in srgb, #16a34a 8%, var(--panel));
  }

  .deployment-status--fail {
    border-color: color-mix(in srgb, #dc2626 50%, var(--line));
    background: color-mix(in srgb, #dc2626 8%, var(--panel));
  }

  .deployment-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    background: var(--panel);
    color: var(--muted);
  }

  .deployment-status--ok .deployment-badge {
    background: #16a34a;
    color: white;
  }

  .deployment-status--fail .deployment-badge {
    background: #dc2626;
    color: white;
  }

  .deployment-meta {
    display: grid;
    gap: 0.2rem;
  }

  .deployment-meta span {
    color: var(--muted);
    font-size: 0.85rem;
  }

  @media (max-width: 1100px) {
    .dashboard-layout,
    .dashboard-columns {
      grid-template-columns: 1fr;
    }

    .support-grid {
      grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    }
  }
</style>
