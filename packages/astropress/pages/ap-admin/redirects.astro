---
import { safeAdminUserName } from "astropress";
import AdminLayout from "@astropress-diy/astropress/components/AdminLayout.astro";
import AuditTrail from "@astropress-diy/astropress/components/AuditTrail.astro";
import CsrfInput from "@astropress-diy/astropress/components/CsrfInput.astro";
import { buildRedirectsPageModel, getPageT, resolveAdminLocale } from "astropress";

const adminUser = Astro.locals.adminUser;
const model = await buildRedirectsPageModel(Astro.locals, adminUser);
const { redirectRules, auditEvents } = model.data;
const wasSaved = Astro.url.searchParams.get("saved") === "1";
const wasDeleted = Astro.url.searchParams.get("deleted") === "1";
const errorMessage =
	Astro.url.searchParams.get("error") === "1" ? Astro.url.searchParams.get("message") : "";
const t = getPageT(resolveAdminLocale(Astro));

if (model.status === "forbidden") {
	Astro.response.status = 403;
}
---

{model.status !== "forbidden" ? (
  <AdminLayout
    title={t("redirects.pageTitle")}
    heading={t("redirects.pageTitle")}
    currentPath="/ap-admin/redirects"
    description={t("redirects.description")}
    userName={safeAdminUserName(adminUser)}
  >
    {model.warnings.length > 0 && <ap-notice type="info">{t("redirects.partialResults")}</ap-notice>}
    <div class="toolbar">
      <a href="#new-rule" class="admin-button">{t("redirects.addRule")}</a>
    </div>
    {wasSaved && <ap-notice type="success" dismiss-after="6000">{t("redirects.savedSuccess")}</ap-notice>}
    {wasDeleted && <ap-notice type="success" dismiss-after="6000">{t("redirects.deletedSuccess")}</ap-notice>}
    {errorMessage && <ap-notice type="error">{errorMessage}</ap-notice>}
    <ap-pending-form>
    <form id="new-rule" class="panel redirect-form" method="post" action="/ap-admin/actions/redirect-create">
      <CsrfInput token={Astro.locals.csrfToken} />
      <div class="section-header">
        <div>
          <p class="admin-kicker">{t("redirects.create")}</p>
          <h2>{t("redirects.newRule")}</h2>
          <p>{t("redirects.newRuleDesc")}</p>
        </div>
      </div>
      <label class="admin-field">
        <span>{t("redirects.legacyPath")}</span>
        <input aria-label={t("redirects.legacyPath")} type="text" name="sourcePath" placeholder="/fresh-start" class="admin-input" autofocus={Boolean(errorMessage)} />
      </label>
      <label class="admin-field">
        <span>{t("redirects.targetPath")}</span>
        <input aria-label={t("redirects.targetPath")} type="text" name="targetPath" placeholder="/about-us-2" class="admin-input" />
      </label>
      <label class="admin-field">
        <span>{t("redirects.statusCode")}</span>
        <select aria-label={t("redirects.statusCode")} name="statusCode" class="admin-select">
          <option value="301">301</option>
          <option value="302">302</option>
        </select>
      </label>
      <button type="submit" class="admin-button">{t("redirects.saveRule")}</button>
    </form>
    </ap-pending-form>
    <section class="panel redirect-list-panel">
      <div class="section-header">
        <div>
          <p class="admin-kicker">{t("redirects.inventory")}</p>
          <h2>{t("redirects.reviewedRules")}</h2>
          <p>{t("redirects.reviewedRulesDesc")}</p>
        </div>
      </div>
      <div class="admin-table-shell">
        <table aria-label={t("redirects.tableAria")}>
          <thead>
            <tr>
              <th>{t("redirects.legacy")}</th>
              <th>{t("redirects.target")}</th>
              <th>{t("common.status")}</th>
              <th>{t("redirects.delete")}</th>
            </tr>
          </thead>
          <tbody>
            {redirectRules.map((rule) => (
              <tr>
                <td>
                  <code>{rule.sourcePath}</code>
                  <button type="button" class="copy-path-btn admin-button-ghost small" data-copy={rule.sourcePath} aria-label={`${t("redirects.copy")} ${rule.sourcePath}`}>{t("redirects.copy")}</button>
                </td>
                <td><code>{rule.targetPath}</code></td>
                <td><span class="admin-chip">{rule.statusCode}</span></td>
                <td>
                  <button
                    type="button"
                    class="admin-button-ghost small delete-button"
                    data-confirm-delete
                    data-confirm-trigger
                    data-dialog-id="confirm-dialog"
                    data-text-dialog-source={rule.sourcePath}
                    data-text-dialog-target={rule.targetPath}
                    data-field-name="sourcePath"
                    data-field-value={rule.sourcePath}
                  >
                    {t("redirects.delete")}
                  </button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    {/* Confirmation Dialog */}
    <ap-confirm-dialog>
      <dialog id="confirm-dialog" class="confirm-modal" aria-labelledby="confirm-dialog-title">
        <div class="modal-content">
          <h2 id="confirm-dialog-title">{t("redirects.deleteDialogTitle")}</h2>
          <p>
            {t("redirects.deleteDialogBody")}
          </p>
          <p class="dialog-context">
            <strong id="dialog-source"></strong> → <strong id="dialog-target"></strong>
          </p>
          <p class="dialog-warning">{t("redirects.deleteWarning")}</p>
          <div class="modal-actions">
            <button type="button" class="admin-button-ghost small secondary-button" data-dialog-close>{t("redirects.cancel")}</button>
            <form id="confirm-form" method="post" style="display: inline;">
              <CsrfInput token={Astro.locals.csrfToken} />
              <input type="hidden" name="sourcePath" value="" />
              <button type="submit" class="admin-button small delete-button">{t("redirects.deleteRule")}</button>
            </form>
          </div>
        </div>
      </dialog>
    </ap-confirm-dialog>
    <AuditTrail events={auditEvents.filter((event) => event.targetType === "redirect").slice(0, 5)} />
    <script>
      import "../../web-components/confirm-dialog";
    </script>
  </AdminLayout>
) : (
  <AdminLayout
    title={t("pages.forbidden.title")}
    heading={t("pages.forbidden.title")}
    currentPath=""
    description={t("pages.forbidden.description")}
    userName={safeAdminUserName(adminUser)}
  >
    <section class="panel forbidden">
      <p>{t("pages.forbidden.body")}</p>
    </section>
  </AdminLayout>
)}

<style>
  .redirect-form {
    display: grid;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .redirect-list-panel {
    display: grid;
    gap: 1rem;
  }

  input,
  select,
  button {
    font: inherit;
  }

  .delete-form {
    display: flex;
  }

  .delete-button {
    border-color: color-mix(in srgb, var(--danger) 50%, var(--line));
    color: var(--danger);
  }


  .copy-path-btn {
    margin-inline-start: 0.4rem;
    font-size: 0.78rem;
    padding: 0.15rem 0.45rem;
    vertical-align: middle;
  }
</style>

<script>
  // Clipboard API: copy source path on button click
  document.addEventListener("click", async (event) => {
    const btn = (event.target as Element).closest<HTMLElement>("[data-copy]");
    if (!btn) return;
    const text = btn.getAttribute("data-copy") ?? "";
    if (!text || !navigator.clipboard) return;
    await navigator.clipboard.writeText(text);
    const original = btn.textContent;
    btn.textContent = "Copied!";
    setTimeout(() => { btn.textContent = original; }, 1500);
  });
</script>
