---
import AdminLayout from "@astropress-diy/astropress/components/AdminLayout.astro";
import {
	buildPostsIndexPageModel,
	getPageT,
	isSeededPostRecord,
	requiresAccess,
	resolveAdminLocale,
} from "astropress";

const adminLocale = resolveAdminLocale(Astro);
const t = getPageT(adminLocale);
function format(template: string, params: Record<string, string | number>) {
	return template.replace(/\{(\w+)\}/g, (_, k) => String(params[k] ?? ""));
}
function tStatus(status: string): string {
	switch (status) {
		case "published":
			return t("common.published");
		case "draft":
			return t("common.draft");
		case "archived":
			return t("common.archived");
		case "review":
			return t("common.inReview");
		default:
			return status;
	}
}
function tWorkflow(label: string): string {
	switch (label) {
		case "scheduled":
			return t("common.scheduled");
		case "review-needed":
			return t("common.needsReview");
		case "unscheduled":
			return t("common.unscheduled");
		default:
			return label.replace("-", " ");
	}
}

// #104: gate the posts index on posts:list; denied subjects are redirected
// (also removes the anon adminUser deref at render).
const postsGuard = await requiresAccess(Astro, "posts:list");
if (postsGuard) return postsGuard;
const adminUser = Astro.locals.adminUser;
if (!adminUser) return Astro.redirect("/ap-admin/login");

if (Astro.url.searchParams.get("type") === "page") {
	return Astro.redirect("/ap-admin/pages", 302);
}

const model = await buildPostsIndexPageModel(Astro.locals);
const { authors, categories, tags, allContent, archives } = model.data;

const rows = allContent.filter((record) => isSeededPostRecord(record));

const query = Astro.url.searchParams;
const statusFilter = query.get("status")?.trim() || "";
const workflowFilter = query.get("workflow")?.trim() || "";
const archiveFilter = query.get("archive")?.trim() || "";
const authorFilter = Number(query.get("author") ?? "");
const categoryFilter = Number(query.get("category") ?? "");
const tagFilter = Number(query.get("tag") ?? "");
const searchFilter = query.get("q")?.trim().toLowerCase() || "";
const now = Date.now();

const authorNamesById = new Map(authors.map((author) => [author.id, author.name]));
const categoryNamesById = new Map(categories.map((term) => [term.id, term.name]));
const tagNamesById = new Map(tags.map((term) => [term.id, term.name]));
const selectedArchive = archives.find((entry) => entry.slug === archiveFilter) ?? null;
const selectedArchiveRoutes = new Set(
	(selectedArchive?.listingItems ?? []).map((item) => item.href),
);

function joinAssignmentLabels(ids: number[] | undefined, labelsById: Map<number, string>) {
	if (!ids || ids.length === 0) {
		return "—";
	}

	const labels = ids
		.map((id) => labelsById.get(id))
		.filter((value): value is string => Boolean(value));
	return labels.length > 0 ? labels.join(", ") : "—";
}

function formatScheduledAt(value: string | undefined) {
	if (!value) {
		return "—";
	}

	return new Date(value).toLocaleString(adminLocale, {
		year: "numeric",
		month: "short",
		day: "numeric",
		hour: "numeric",
		minute: "2-digit",
	});
}

function getWorkflowLabel(state: (typeof rows)[number]) {
	const effectiveStatus = state.status || "published";
	const scheduledAt = state.scheduledAt;
	const scheduledMs = scheduledAt ? Date.parse(scheduledAt) : Number.NaN;

	if (scheduledAt && Number.isFinite(scheduledMs) && scheduledMs > now) {
		return "scheduled";
	}

	if (effectiveStatus === "review" || effectiveStatus === "draft") {
		return "review-needed";
	}

	if (!scheduledAt) {
		return "unscheduled";
	}

	return "scheduled";
}

const PAGE_SIZE = 25;
const currentPage = Math.max(Number(query.get("page") ?? "1") || 1, 1);

const filteredRows = rows.filter((page) => {
	const effectiveStatus = page.status || "published";
	const authorIds = page.authorIds ?? [];
	const categoryIds = page.categoryIds ?? [];
	const tagIds = page.tagIds ?? [];
	const workflowLabel = getWorkflowLabel(page);
	const matchesArchive =
		!archiveFilter || selectedArchiveRoutes.size === 0 || selectedArchiveRoutes.has(page.legacyUrl);
	const matchesSearch =
		searchFilter.length === 0 ||
		[
			page.title,
			page.slug,
			page.legacyUrl,
			joinAssignmentLabels(authorIds, authorNamesById),
			joinAssignmentLabels(categoryIds, categoryNamesById),
			joinAssignmentLabels(tagIds, tagNamesById),
			formatScheduledAt(page.scheduledAt),
			workflowLabel,
		]
			.join(" ")
			.toLowerCase()
			.includes(searchFilter);

	return (
		(!statusFilter || effectiveStatus === statusFilter) &&
		(!workflowFilter || workflowLabel === workflowFilter) &&
		matchesArchive &&
		(!Number.isInteger(authorFilter) || authorFilter <= 0 || authorIds.includes(authorFilter)) &&
		(!Number.isInteger(categoryFilter) ||
			categoryFilter <= 0 ||
			categoryIds.includes(categoryFilter)) &&
		(!Number.isInteger(tagFilter) || tagFilter <= 0 || tagIds.includes(tagFilter)) &&
		matchesSearch
	);
});

const totalPages = Math.max(Math.ceil(filteredRows.length / PAGE_SIZE), 1);
const safePage = Math.min(currentPage, totalPages);
const pagedRows = filteredRows.slice((safePage - 1) * PAGE_SIZE, safePage * PAGE_SIZE);

function paginationHref(targetPage: number) {
	const p = new URLSearchParams(query);
	p.set("page", String(targetPage));
	return `/ap-admin/posts?${p.toString()}`;
}
---

<AdminLayout
  title={t("posts.pageTitle")}
  heading={t("posts.pageTitle")}
  currentPath="/ap-admin/posts"
  description={t("posts.description")}
  userName={adminUser.name}
>
  {model.warnings.length > 0 && <p class="notice">{t("posts.partialResults")}</p>}
  <div class="toolbar">
    <a href="/ap-admin/posts/new" class="admin-button">{t("dashboard.newPost")}</a>
    <a href="/blog" class="admin-button-secondary">{t("posts.openPublicBlog")}</a>
  </div>
  <div class="admin-subgrid two summary-grid">
    <section class="panel stat summary-card">
      <span>{t("posts.visiblePosts")}</span>
      <strong>{filteredRows.length}</strong>
      <span>{t("posts.visiblePostsDesc")}</span>
    </section>
    <section class="panel stat summary-card">
      <span>{t("posts.reviewQueue")}</span>
      <strong>{rows.filter((record) => (record.status ?? "published") === "review" || (record.status ?? "published") === "draft").length}</strong>
      <span>{t("posts.reviewQueueDesc")}</span>
    </section>
  </div>
  <section class="panel post-search-panel">
      <div class="section-header">
      <div>
        <p class="admin-kicker">{t("posts.workflow")}</p>
        <h2>{t("posts.blogPostList")}</h2>
        <p>{t("posts.searchOnce")}</p>
      </div>
      <div class="filter-shortcuts">
        <a href="/ap-admin/posts?workflow=review-needed" class="admin-button-ghost small">{t("common.needsReview")}</a>
        <a href="/ap-admin/posts?workflow=scheduled" class="admin-button-ghost small">{t("common.scheduled")}</a>
        <a href="/ap-admin/posts?status=published" class="admin-button-ghost small">{t("common.published")}</a>
      </div>
    </div>
    <form method="get" class="search-shell" aria-label={t("posts.contentFilters")}>
      <div class="search-row">
        <label class="search-field">
          <span class="sr-only">{t("posts.searchPosts")}</span>
          <input type="search" name="q" value={searchFilter} placeholder={t("posts.searchPlaceholder")} aria-label={t("posts.searchPosts")} />
        </label>
        <button type="submit" class="admin-button">{t("posts.searchPosts")}</button>
        <a href="/ap-admin/posts" class="admin-button-ghost">{t("common.clearFilters")}</a>
      </div>
      <div class="filters">
        <label>
          <span>{t("common.status")}</span>
          <select name="status">
            <option value="">{t("common.allStatuses")}</option>
            <option value="published" selected={statusFilter === "published"}>{t("common.published")}</option>
            <option value="review" selected={statusFilter === "review"}>{t("common.inReview")}</option>
            <option value="draft" selected={statusFilter === "draft"}>{t("common.draft")}</option>
            <option value="archived" selected={statusFilter === "archived"}>{t("common.archived")}</option>
          </select>
        </label>
        <label>
          <span>{t("posts.workflowFilter")}</span>
          <select name="workflow">
            <option value="">{t("posts.allWorkflowStates")}</option>
            <option value="scheduled" selected={workflowFilter === "scheduled"}>{t("common.scheduled")}</option>
            <option value="review-needed" selected={workflowFilter === "review-needed"}>{t("common.needsReview")}</option>
            <option value="unscheduled" selected={workflowFilter === "unscheduled"}>{t("common.unscheduled")}</option>
          </select>
        </label>
        {selectedArchive && <input type="hidden" name="archive" value={selectedArchive.slug} />}
        <label>
          <span>{t("common.author")}</span>
          <select name="author">
            <option value="">{t("common.allAuthors")}</option>
            {authors.map((author) => (
              <option value={author.id} selected={authorFilter === author.id}>{author.name}</option>
            ))}
          </select>
        </label>
        <label>
          <span>{t("common.category")}</span>
          <select name="category">
            <option value="">{t("common.allCategories")}</option>
            {categories.map((term) => (
              <option value={term.id} selected={categoryFilter === term.id}>{term.name}</option>
            ))}
          </select>
        </label>
        <label>
          <span>{t("posts.tag")}</span>
          <select name="tag">
            <option value="">{t("common.allTags")}</option>
            {tags.map((term) => (
              <option value={term.id} selected={tagFilter === term.id}>{term.name}</option>
            ))}
          </select>
        </label>
      </div>
    </form>
    {selectedArchive && (
      <p class="field-note">
        {t("posts.archiveFilter")} <strong>{selectedArchive.title}</strong>
      </p>
    )}
    <p class="field-note">{format(t("posts.matchedSummary"), { count: filteredRows.length, page: safePage, total: totalPages })}</p>
    <div class="admin-table-shell">
      <table aria-label={t("posts.contentList")}>
        <thead>
          <tr>
            <th>{t("common.title")}</th>
            <th>{t("common.status")}</th>
            <th>{t("posts.workflowFilter")}</th>
            <th>{t("posts.tableScheduled")}</th>
            <th>{t("posts.authors")}</th>
            <th>{t("posts.categories")}</th>
          </tr>
        </thead>
        <tbody>
          {pagedRows.map((page) => {
            const workflowLabel = getWorkflowLabel(page);
            return (
              <tr>
                <td>
                  <div class="title-cell">
                    <a href={`/ap-admin/posts/${page.slug}`}>{page.title}</a>
                    <span>{page.legacyUrl}</span>
                  </div>
                </td>
                <td>{tStatus(page.status || "published")}</td>
                <td><span class={`workflow-chip ${workflowLabel}`}>{tWorkflow(workflowLabel)}</span></td>
                <td>{formatScheduledAt(page.scheduledAt)}</td>
                <td>{joinAssignmentLabels(page.authorIds, authorNamesById)}</td>
                <td>{joinAssignmentLabels(page.categoryIds, categoryNamesById)}</td>
              </tr>
            );
          })}
          {pagedRows.length === 0 && (
            <tr>
              <td colspan="6">{t("posts.noMatched")}</td>
            </tr>
          )}
        </tbody>
      </table>
    </div>
    {totalPages > 1 && (
      <nav aria-label={t("posts.pagination")} class="pagination-nav">
        {safePage > 1
          ? <a href={paginationHref(safePage - 1)} class="admin-button-ghost" rel="prev" aria-label={t("posts.previousPage")}>{t("posts.previous")}</a>
          : <span class="admin-button-ghost disabled" aria-disabled="true">{t("posts.previous")}</span>
        }
        <span class="page-counter" aria-current="page">{format(t("posts.pageOf"), { page: safePage, total: totalPages })}</span>
        {safePage < totalPages
          ? <a href={paginationHref(safePage + 1)} class="admin-button-ghost" rel="next" aria-label={t("posts.nextPage")}>{t("posts.next")}</a>
          : <span class="admin-button-ghost disabled" aria-disabled="true">{t("posts.next")}</span>
        }
      </nav>
    )}
  </section>
</AdminLayout>

<style>
  .summary-grid {
    margin-bottom: 1rem;
  }

  .summary-card span:first-child {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    font-weight: 700;
  }

  .summary-card span:last-child {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .post-search-panel {
    display: grid;
    gap: 1rem;
  }

  .search-shell {
    display: grid;
    gap: 0.9rem;
  }

  .search-row {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    align-items: center;
  }

  .search-field {
    flex: 1 1 20rem;
  }

  .search-field input {
    width: 100%;
  }

  .filters {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 0.9rem;
  }

  .filters label {
    display: grid;
    gap: 0.35rem;
  }

  .filters select,
  .search-field input {
    font: inherit;
    border-radius: 0.85rem;
    border: 1px solid var(--line);
    padding: 0.75rem 0.9rem;
    background: var(--panel);
    color: var(--text);
  }

  .filter-shortcuts {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .filters span,
  .field-note {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .title-cell {
    display: grid;
    gap: 0.18rem;
  }

  .title-cell a {
    color: inherit;
    font-weight: 700;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }

  .pagination-nav {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    justify-content: center;
    padding: 0.75rem 0;
  }

  .page-counter {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .admin-button-ghost.disabled {
    opacity: 0.4;
    cursor: default;
    pointer-events: none;
  }

  .title-cell span {
    color: var(--muted);
    font-size: 0.84rem;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }
</style>
