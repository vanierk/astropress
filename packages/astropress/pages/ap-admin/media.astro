---
import AdminLayout from "@astropress-diy/astropress/components/AdminLayout.astro";
import AuditTrail from "@astropress-diy/astropress/components/AuditTrail.astro";
import CsrfInput from "@astropress-diy/astropress/components/CsrfInput.astro";
import { buildMediaPageModel, getPageT, requiresAccess, resolveAdminLocale } from "astropress";

// #104/#106: gate on media:list so the page and the picker API
// (pages/ap-admin/api/media.ts) share one rule; denied subjects are redirected.
const guard = await requiresAccess(Astro, "media:list");
if (guard) return guard;
const adminUser = Astro.locals.adminUser;
if (!adminUser) return Astro.redirect("/ap-admin/login");
const model = await buildMediaPageModel(Astro.locals);
const { mediaWithResolvedUrls, auditEvents } = model.data;
const wasSaved = Astro.url.searchParams.get("saved") === "1";
const wasDeleted = Astro.url.searchParams.get("deleted") === "1";
const errorMessage =
	Astro.url.searchParams.get("error") === "1" ? Astro.url.searchParams.get("message") : "";
const t = getPageT(resolveAdminLocale(Astro));
---

<AdminLayout
  title={t("media.pageTitle")}
  heading={t("media.pageTitle")}
  currentPath="/ap-admin/media"
  description={t("media.description")}
  userName={adminUser.name}
>
  {model.warnings.length > 0 && <p class="notice">{t("media.partialResults")}</p>}
  {wasSaved && <p class="notice">{t("media.savedSuccess")}</p>}
  {wasDeleted && <p class="notice">{t("media.deletedSuccess")}</p>}
  {errorMessage && <p class="error-notice">{errorMessage}</p>}

  <div class="admin-subgrid two summary-grid">
    <section class="panel stat summary-card">
      <span>{t("media.totalAssets")}</span>
      <strong>{mediaWithResolvedUrls.length}</strong>
      <span>{t("media.totalAssetsDesc")}</span>
    </section>
    <section class="panel stat summary-card">
      <span>{t("media.missingAlt")}</span>
      <strong>{mediaWithResolvedUrls.filter((asset) => !asset.altText).length}</strong>
      <span>{t("media.missingAltDesc")}</span>
    </section>
  </div>

  <section class="panel upload-panel">
    <div class="section-header">
      <div>
        <p class="admin-kicker">{t("media.addAssets")}</p>
        <h2>{t("media.uploadMedia")}</h2>
        <p>{t("media.uploadDesc")}</p>
      </div>
    </div>
    <form method="post" action="/ap-admin/actions/media-upload" enctype="multipart/form-data" class="upload-form admin-form-grid">
      <CsrfInput token={Astro.locals.csrfToken} />
      <label class="admin-field">
        <span>{t("media.file")}</span>
        <input aria-label={t("media.fileAria")} type="file" name="file" accept="image/*" required data-error-required={t("media.fileRequired")} class="admin-input" />
      </label>
      <label class="admin-field">
        <span>{t("common.title")}</span>
        <input aria-label={t("media.titleAria")} type="text" name="title" class="admin-input" />
      </label>
      <label class="admin-field">
        <span>{t("media.altText")}</span>
        <input aria-label={t("media.altAria")} type="text" name="altText" class="admin-input" />
      </label>
      <button type="submit" class="admin-button">{t("media.uploadButton")}</button>
      <div class="upload-progress" hidden aria-live="polite">
        <div class="upload-progress__bar"></div>
        <span class="upload-progress__text">{t("media.uploading")}</span>
      </div>
    </form>
  </section>

  <section class="panel library-panel">
    <div class="section-header">
      <div>
        <p class="admin-kicker">{t("media.browse")}</p>
        <h2>{t("media.libraryGrid")}</h2>
        <p>{t("media.libraryGridDesc")}</p>
      </div>
    </div>
    <div class="media-grid">
      {mediaWithResolvedUrls.length === 0 && (
        <p class="admin-empty-state">{t("media.noAssets")}</p>
      )}
      {mediaWithResolvedUrls.map((asset: any) => (
        <div class="media-card">
          <img src={asset.resolvedUrl} alt={asset.altText || asset.title || asset.id} loading="lazy" />
          <p class="filename">{asset.sourceUrl?.split("/").pop() || asset.id}</p>
          <p class="source">{asset.sourceUrl || asset.resolvedUrl}</p>
          <p class="meta">{asset.title || asset.id}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="panel library-panel">
    <div class="section-header">
      <div>
        <p class="admin-kicker">{t("media.metadata")}</p>
        <h2>{t("media.libraryList")}</h2>
        <p>{t("media.libraryListDesc")}</p>
      </div>
    </div>
    <div class="admin-table-shell">
      <table aria-label={t("media.assets")}>
        <thead>
          <tr>
            <th>{t("media.id")}</th>
            <th>{t("media.preview")}</th>
            <th>{t("media.titleAlt")}</th>
            <th>{t("media.localPath")}</th>
            <th>{t("media.r2Key")}</th>
            <th>{t("media.sourceUrl")}</th>
            <th>{t("common.actions")}</th>
          </tr>
        </thead>
        <tbody>
          {mediaWithResolvedUrls.map((asset: any) => (
            <tr>
              <td>{asset.id}</td>
              <td><img class="thumb" src={asset.resolvedUrl} alt={asset.altText || asset.title || asset.id} loading="lazy" /></td>
              <td>
                <p class="asset-title">{asset.title || asset.id}</p>
                <p class="asset-alt">{asset.altText || t("media.noAlt")}</p>
                <form method="post" action="/ap-admin/actions/media-update" class="meta-form admin-form-grid">
                  <CsrfInput token={Astro.locals.csrfToken} />
                  <input type="hidden" name="id" value={asset.id} />
                  <input aria-label={`${t("common.title")} ${asset.id}`} type="text" name="title" value={asset.title || ""} class="admin-input" />
                  <input aria-label={`${t("media.altText")} ${asset.id}`} type="text" name="altText" value={asset.altText || ""} class="admin-input" />
                  <button type="submit" class="admin-button small">{t("media.saveMetadata")}</button>
                </form>
              </td>
              <td>{asset.resolvedUrl || "-"}</td>
              <td>{asset.r2Key || "-"}</td>
              <td>{asset.sourceUrl || "-"}</td>
              <td>
                <button
                  type="button"
                  class="admin-button-ghost small danger-button"
                  data-confirm-trigger
                  data-dialog-id="confirm-delete-media"
                  data-field-name="id"
                  data-field-value={asset.id}
                >
                  {t("media.delete")}
                </button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <ap-confirm-dialog>
    <dialog id="confirm-delete-media" class="confirm-modal" aria-labelledby="confirm-delete-media-title">
      <div class="modal-content">
        <h2 id="confirm-delete-media-title">{t("media.deleteDialogTitle")}</h2>
        <p>{t("media.deleteDialogBody")}</p>
        <p class="dialog-warning">{t("media.deleteWarning")}</p>
        <div class="modal-actions">
          <button type="button" class="admin-button-ghost small secondary-button" data-dialog-close>{t("media.cancel")}</button>
          <form method="post" action="/ap-admin/actions/media-delete" style="display:inline;">
            <CsrfInput token={Astro.locals.csrfToken} />
            <input type="hidden" name="id" value="" />
            <button type="submit" class="admin-button small delete-button">{t("media.deleteAsset")}</button>
          </form>
        </div>
      </div>
    </dialog>
  </ap-confirm-dialog>
  <script>
    import "../../web-components/confirm-dialog";
  </script>
  <AuditTrail events={auditEvents.filter((event) => event.action.startsWith("media.")).slice(0, 6)} heading={t("audit.mediaAudit")} />
</AdminLayout>

<style>
  .summary-grid,
  .upload-panel,
  .library-panel {
    margin-bottom: 1rem;
  }

  .summary-card span:first-child {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    font-weight: 700;
  }

  .summary-card span:last-child {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .upload-form,
  .meta-form {
    display: grid;
    gap: 0.75rem;
  }

  .upload-form label,
  .meta-form label {
    display: grid;
    gap: 0.35rem;
  }

  .media-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 1rem;
  }

  .media-card {
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: var(--surface);
  }

  .media-card img,
  .thumb {
    width: 100%;
    max-width: 120px;
    height: auto;
    border-radius: 0.5rem;
    display: block;
    margin-bottom: 0.75rem;
  }

  .media-card .filename {
    font-weight: bold;
    font-size: 0.9rem;
    margin: 0 0 0.5rem 0;
    word-break: break-word;
  }

  .media-card .source {
    font-size: 0.8rem;
    color: var(--muted);
    margin: 0;
  }

  .media-card .meta {
    font-size: 0.8rem;
    margin: 0.5rem 0 0;
    color: var(--muted);
  }

  .asset-title {
    margin: 0 0 0.35rem;
    font-weight: 700;
  }

  .asset-alt {
    margin: 0 0 0.5rem;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .danger-button {
    border-color: color-mix(in srgb, var(--danger) 50%, var(--line));
    color: var(--danger);
  }

  .upload-progress {
    grid-column: 1 / -1;
    margin-top: 0.25rem;
  }
  .upload-progress__bar {
    height: 4px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--accent) 25%, var(--accent-soft, #e0e7ff) 50%, var(--accent) 75%);
    background-size: 200% 100%;
    animation: ap-upload-shimmer 1.4s ease infinite;
  }
  .upload-progress__text {
    display: block;
    font-size: 0.82rem;
    color: var(--muted);
    margin-top: 0.35rem;
  }
  @keyframes ap-upload-shimmer {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }
</style>
<script>
  const uploadForm = document.querySelector<HTMLFormElement>(".upload-form");
  const progress = uploadForm?.querySelector<HTMLElement>(".upload-progress");
  if (uploadForm && progress) {
    uploadForm.addEventListener("submit", () => {
      progress.hidden = false;
    });
  }
</script>
