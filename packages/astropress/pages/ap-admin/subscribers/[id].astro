---
import AdminLayout from "@astropress-diy/astropress/components/AdminLayout.astro";
import CsrfInput from "@astropress-diy/astropress/components/CsrfInput.astro";
import { createListmonkOps } from "@astropress-diy/astropress/newsletter-adapter";
import { getNewsletterConfig } from "@astropress-diy/astropress/runtime-env";
import { getPageT, requiresAccess, resolveAdminLocale } from "astropress";

const guard = await requiresAccess(Astro, "subscribers:view");
if (guard) return guard;
const adminUser = Astro.locals.adminUser;
if (!adminUser) return Astro.redirect("/ap-admin/login");
const adminLocale = resolveAdminLocale(Astro);
const t = getPageT(adminLocale);

const { id } = Astro.params as { id: string };

interface SubscriberDetail {
	id: string | number;
	email: string;
	name: string;
	status: string;
	createdAt: string;
}

let subscriber: SubscriberDetail | null = null;
let listSupported = false;
let errorMessage = "";

try {
	const cfg = getNewsletterConfig(Astro.locals);
	if (
		cfg.mode === "listmonk" &&
		cfg.listmonkApiUrl &&
		cfg.listmonkApiUsername &&
		cfg.listmonkApiPassword &&
		cfg.listmonkListId
	) {
		listSupported = true;
		const ops = createListmonkOps({
			apiUrl: cfg.listmonkApiUrl,
			apiUsername: cfg.listmonkApiUsername,
			apiPassword: cfg.listmonkApiPassword,
			listId: Number(cfg.listmonkListId),
		});
		const result = await ops.getSubscriber(id);
		subscriber = result.subscriber as SubscriberDetail;
	}
} catch (e) {
	errorMessage = t("subscribers.detail.loadError");
}

const wasDeleted = Astro.url.searchParams.get("deleted") === "1";
---

  <AdminLayout
    title={subscriber ? `${subscriber.email} — ${t("subscribers.detail.breadcrumb")}` : t("subscribers.detail.fallbackTitle")}
    heading={subscriber ? subscriber.email : t("subscribers.detail.fallbackTitle")}
    description={t("subscribers.detail.description")}
    userName={adminUser.name}
    currentPath="/ap-admin/subscribers"
  >
    <nav class="breadcrumb" aria-label="breadcrumb">
      <a href="/ap-admin/subscribers">{t("subscribers.detail.breadcrumb")}</a>
      <span aria-hidden="true"> / </span>
      <span aria-current="page">{subscriber ? subscriber.email : id}</span>
    </nav>

    {wasDeleted && <p class="notice">{t("subscribers.detail.removedSuccess")}</p>}
    {errorMessage && <p class="error-notice">{errorMessage}</p>}

    {!listSupported && !errorMessage && (
      <div class="notice">
        <p>{t("subscribers.detail.listmonkRequiredPrefix")} <code>LISTMONK_*</code> {t("subscribers.detail.listmonkRequiredSuffix")}</p>
      </div>
    )}

    {listSupported && subscriber && (
      <div class="subscriber-detail">
        <div class="detail-card">
          <dl class="detail-list">
            <div class="detail-row">
              <dt>{t("subscribers.detail.emailLabel")}</dt>
              <dd class="detail-email">{subscriber.email}</dd>
            </div>
            <div class="detail-row">
              <dt>{t("subscribers.detail.nameLabel")}</dt>
              <dd>{subscriber.name || <span class="muted">—</span>}</dd>
            </div>
            <div class="detail-row">
              <dt>{t("common.status")}</dt>
              <dd>
                <span class={`status-badge status-badge--${subscriber.status}`}>{subscriber.status}</span>
              </dd>
            </div>
            <div class="detail-row">
              <dt>{t("subscribers.detail.subscribedLabel")}</dt>
              <dd class="muted">
                {subscriber.createdAt ? new Date(subscriber.createdAt).toLocaleString(adminLocale) : "—"}
              </dd>
            </div>
            <div class="detail-row">
              <dt>{t("subscribers.detail.idLabel")}</dt>
              <dd class="muted">{subscriber.id}</dd>
            </div>
          </dl>
        </div>

        <div class="danger-zone">
          <h2 class="danger-zone__title">{t("subscribers.detail.removeSubscriber")}</h2>
          <p class="danger-zone__desc">
            {t("subscribers.detail.removeWarning")}
          </p>
          <button
            type="button"
            class="delete-btn"
            data-confirm-trigger
            data-dialog-id="confirm-delete-subscriber"
            data-field-name="id"
            data-field-value={String(subscriber.id)}
            data-text-subscriber-email={subscriber.email}
          >
            {t("subscribers.detail.removeSubscriber")}
          </button>
        </div>
        <ap-confirm-dialog>
          <dialog id="confirm-delete-subscriber" class="confirm-modal" aria-labelledby="confirm-delete-subscriber-title">
            <div class="modal-content">
              <h2 id="confirm-delete-subscriber-title">{t("subscribers.detail.removeConfirmTitle")}</h2>
              <p>{t("subscribers.detail.confirmRemovePrefix")} <strong id="subscriber-email"></strong>?</p>
              <p class="dialog-warning">{t("subscribers.detail.actionCannotBeUndone")}</p>
              <div class="modal-actions">
                <button type="button" class="admin-button-ghost small secondary-button" data-dialog-close>{t("postEditor.cancel")}</button>
                <form method="post" action="/ap-admin/actions/subscriber-delete" style="display:inline;">
                  <CsrfInput token={Astro.locals.csrfToken} />
                  <input type="hidden" name="id" value="" />
                  <button type="submit" class="admin-button small delete-button">{t("subscribers.detail.removeSubscriberSubmit")}</button>
                </form>
              </div>
            </div>
          </dialog>
        </ap-confirm-dialog>
      </div>
    )}

    {listSupported && !subscriber && !errorMessage && (
      <p class="error-notice">{t("subscribers.detail.notFound")}</p>
    )}

    <style>
      .subscriber-detail { max-width: 560px; }
      .detail-card { border: 1px solid var(--border, #e5e7eb); border-radius: 8px; background: var(--surface, #fff); padding: 1.25rem; margin-bottom: 1.5rem; }
      .detail-list { margin: 0; }
      .detail-row { display: flex; gap: 1rem; padding: 0.625rem 0; border-bottom: 1px solid var(--border, #e5e7eb); }
      .detail-row:last-child { border-bottom: none; }
      .detail-row dt { width: 140px; flex-shrink: 0; font-size: 0.875rem; font-weight: 500; color: var(--text-muted, #374151); padding-top: 0.0625rem; }
      .detail-row dd { margin: 0; font-size: 0.9375rem; }
      .detail-email { font-weight: 500; word-break: break-all; }
      .muted { color: var(--text-muted, #374151); font-size: 0.875rem; }
      .status-badge { display: inline-block; padding: 0.125rem 0.5rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 500; text-transform: capitalize; background: var(--status-bg, #f3f4f6); }
      .status-badge--enabled, .status-badge--subscribed { background: #dcfce7; color: #166534; }
      .status-badge--disabled, .status-badge--unsubscribed { background: #fee2e2; color: #991b1b; }
      .status-badge--blocklisted { background: #fef3c7; color: #92400e; }
      .danger-zone { border: 1px solid #fca5a5; border-radius: 8px; padding: 1.25rem; background: #fff7f7; }
      .danger-zone__title { margin: 0 0 0.5rem; font-size: 0.9375rem; font-weight: 600; color: #991b1b; }
      .danger-zone__desc { font-size: 0.875rem; color: #374151; margin: 0 0 1rem; }
      .delete-btn { padding: 0.5rem 1rem; background: #dc2626; color: #fff; border: none; border-radius: 6px; font-size: 0.875rem; font-weight: 500; cursor: pointer; }
      .delete-btn:hover { background: #b91c1c; }
    </style>
    <script>
      import "../../../web-components/confirm-dialog";
    </script>
  </AdminLayout>
