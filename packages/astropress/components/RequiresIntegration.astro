---
import type { AdminLocale } from "astropress";
/**
 * Empty-state shown when an admin leaf has no backing integration configured.
 *
 * Renders the capability name, a short description, the supported providers
 * with vendor links, and a copy-paste registerCms snippet so the operator can
 * enable the feature without leaving the page.
 */
import { getAdminLabel, getPageT } from "astropress";

interface Provider {
	name: string;
	href?: string;
	tag?: "Recommended" | "Self-hosted" | "OSS" | "SaaS";
}

const STUB_PROVIDER_TAG_KEYS: Record<NonNullable<Provider["tag"]>, string> = {
	Recommended: "stubProviderTag.recommended",
	"Self-hosted": "stubProviderTag.selfHosted",
	OSS: "stubProviderTag.oss",
	SaaS: "stubProviderTag.saas",
};

/**
 * - "env-gated" (default): the integration is real but unconfigured.
 *   Show the configHint snippet so the operator can enable it.
 * - "coming-soon": the integration is on the roadmap but not built.
 *   Suppress configHint (it would imply a copy-paste fixes things);
 *   surface a roadmap link instead. Required for any leaf marked
 *   `status: "coming-soon"` in `integration-manifest.ts`.
 */
type Variant = "env-gated" | "coming-soon";

interface Props {
	capability: string;
	description: string;
	configHint: string;
	providers: Provider[];
	docsHref?: string;
	locale: AdminLocale;
	variant?: Variant;
	roadmapHref?: string;
	/**
	 * When set, resolves `stub.<stubKey>.capability` / `.description` via
	 * getPageT (English-seeded, other locales backfilled by translate-locale.ts
	 * + native review) with the passed-in prop as the safety-net fallback.
	 * Omitted by any future non-stub-catalog consumer of this component.
	 */
	stubKey?: string;
}

const {
	capability,
	description,
	configHint,
	providers,
	docsHref,
	locale,
	variant = "env-gated",
	roadmapHref,
	stubKey,
} = Astro.props;

const t = getPageT(locale);
const translatedCapability = stubKey ? t(`stub.${stubKey}.capability`, capability) : capability;
const translatedDescription = stubKey ? t(`stub.${stubKey}.description`, description) : description;

const tHeading =
	variant === "coming-soon"
		? getAdminLabel("stubComingSoonHeading", locale)
		: getAdminLabel("stubNotConfiguredHeading", locale);
const tHowTo = getAdminLabel("stubHowToEnable", locale);
const tProviders = getAdminLabel("stubSupportedProviders", locale);
const tLearnMore = getAdminLabel("stubLearnMore", locale);
const tRoadmapBody = variant === "coming-soon" ? getAdminLabel("stubComingSoonBody", locale) : "";
const tRoadmapLink = variant === "coming-soon" ? getAdminLabel("stubComingSoonLink", locale) : "";
---

<section class="panel stub-panel" aria-labelledby="stub-heading">
  <header>
    <span class="stub-eyebrow">{tHeading}</span>
    <h2 id="stub-heading">{translatedCapability}</h2>
    <p>{translatedDescription}</p>
  </header>

  <div class="stub-grid">
    {variant === "coming-soon" ? (
      <section aria-labelledby="stub-roadmap" class="stub-roadmap">
        <p>{tRoadmapBody}</p>
        {roadmapHref && (
          <p>
            <a href={roadmapHref} rel="noopener" id="stub-roadmap">{tRoadmapLink}</a>
          </p>
        )}
      </section>
    ) : (
      <section aria-labelledby="stub-howto">
        <h3 id="stub-howto">{tHowTo}</h3>
        <pre><code>{configHint}</code></pre>
        {docsHref && (
          <p>
            <a href={docsHref} rel="noopener">{tLearnMore}</a>
          </p>
        )}
      </section>
    )}

    <section aria-labelledby="stub-providers">
      <h3 id="stub-providers">{tProviders}</h3>
      <ul class="stub-providers">
        {providers.map((p) => (
          <li>
            {p.href ? (
              <a href={p.href} rel="noopener">{p.name}</a>
            ) : (
              <span>{p.name}</span>
            )}
            {p.tag && <span class={`stub-tag stub-tag-${p.tag.toLowerCase().replace(/[^a-z]/g, "")}`}>{t(STUB_PROVIDER_TAG_KEYS[p.tag])}</span>}
          </li>
        ))}
      </ul>
    </section>
  </div>
</section>

<style>
  .stub-panel {
    display: grid;
    gap: 1.5rem;
  }
  .stub-eyebrow {
    display: inline-block;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ap-color-muted, #6b7280);
    margin-bottom: 0.25rem;
  }
  .stub-panel h2 {
    margin: 0 0 0.5rem 0;
  }
  .stub-grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }
  @media (max-width: 720px) {
    .stub-grid { grid-template-columns: minmax(0, 1fr); }
  }
  .stub-grid h3 {
    font-size: 0.95rem;
    margin: 0 0 0.5rem 0;
  }
  .stub-grid pre {
    background: var(--ap-color-code-bg, #0f172a);
    color: var(--ap-color-code-fg, #e2e8f0);
    padding: 0.85rem 1rem;
    border-radius: 6px;
    overflow-x: auto;
    font-size: 0.85rem;
    line-height: 1.5;
  }
  .stub-providers {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.45rem;
  }
  .stub-providers li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .stub-tag {
    font-size: 0.7rem;
    padding: 0.1rem 0.5rem;
    border-radius: 9999px;
    background: var(--ap-color-pill-bg, #e5e7eb);
    color: var(--ap-color-pill-fg, #374151);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .stub-tag-recommended {
    background: var(--ap-color-pill-good-bg, #dcfce7);
    color: var(--ap-color-pill-good-fg, #166534);
  }
</style>
