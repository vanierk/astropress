---
import CsrfInput from "./CsrfInput.astro";
import { getAccessContext } from "../src/access/index";
import { NAV_ACTION_BY_HREF } from "../src/access/nav-action-map-data";
import { buildAstropressAdminDocumentTitle } from "../src/admin-branding";
import { localeDirection, resolveAdminLocale } from "../src/admin-locale";
import { getPageT } from "../src/admin-page-labels";
import { getRecentAdminItems } from "../src/admin-recent";
import { getAdminLabel, resolveAstropressAdminUiConfig } from "../src/admin-ui";
import { peekCmsConfig } from "../src/config";
import { INTEGRATIONS, type IntegrationEntry } from "../src/integration-manifest";
import { getAdminBootstrapConfig } from "../src/runtime-env";
import { applyAstropressSecurityHeaders } from "../src/security-headers";

interface NavItem {
	href?: string;
	label: string;
	adminOnly?: boolean;
	/**
	 * ABAC action ID required to surface this leaf. When set and an access
	 * context is available, the leaf renders only if `engine.can(action)`
	 * allows. Server-side `requiresAccess` on the destination page is the
	 * source of truth; nav filtering is a UI mirror.
	 */
	requiredAction?: string;
	isGroupLabel?: boolean;
	indent?: boolean;
	/**
	 * When true, the group separator and its child leaves render visually
	 * demoted ("Coming soon" group). Honesty signal: operators see at a
	 * glance that these aren't shipping features.
	 */
	mutedGroup?: boolean;
}

interface Props {
	title: string;
	heading: string;
	currentPath: string;
	description?: string;
	/**
	 * @deprecated Display-only legacy role enum. Optional — derived from the
	 * access context when omitted. Authorization decisions must use
	 * access.subject.isAdmin / engine.can() instead.
	 */
	role?: "admin" | "editor";
	// Optional: pages pass `adminUser.name` (an optional field). Renders as empty
	// when absent; callers that need a guaranteed string use safeAdminUserName.
	userName?: string;
	siteName?: string;
	/** When true, shows the CMS nav item linking to /ap-admin/cms. */
	hasCms?: boolean;
	/** When true, shows the Host nav item (admin-only) linking to /ap-admin/host. */
	hasHostPanel?: boolean;
	/** When true, shows the Publish button in the topbar (admin-only). */
	canPublish?: boolean;
}

const {
	title,
	heading,
	currentPath,
	description = "",
	role,
	userName = "",
	siteName,
	hasCms = false,
	hasHostPanel = false,
	canPublish = false,
} = Astro.props;
const documentTitle = buildAstropressAdminDocumentTitle(title);
const adminLocale = resolveAdminLocale(Astro);
const adminDir = localeDirection(adminLocale);
const adminUi = resolveAstropressAdminUiConfig(adminLocale);
const tLayout = getPageT(adminLocale);
const adminSiteName = siteName ?? adminUi.branding.shellName;
const { bootstrapDisabled } = getAdminBootstrapConfig(Astro.locals);
applyAstropressSecurityHeaders(Astro.response.headers, {
	area: "admin",
	allowInlineStyles: import.meta.env.DEV,
	forceHsts: Astro.url.protocol === "https:",
});
const access = await getAccessContext(Astro);
const isAdminRole = access?.subject.isAdmin ?? role === "admin";
const displayRole: "admin" | "editor" = role ?? (isAdminRole ? "admin" : "editor");
const recentItems = await getRecentAdminItems(Astro.locals, {
	id: access?.subject.id ?? "",
	email: access?.subject.email ?? "",
	isAdmin: isAdminRole,
});

const pluginNavItems: NavItem[] = (peekCmsConfig()?.plugins ?? [])
	.flatMap((p) => p.navItems ?? [])
	.map((item) => ({ href: item.href, label: item.label, indent: true }));

// Information architecture: every leaf is always rendered. Pages whose
// backing integration is absent show <RequiresIntegration> as their body, so
// nav advertises the platform's full capability surface even on minimal
// installs. Group order: Site → Content → Audience → Discoverability →
// Integrations → Access → Operations.
const groupSep = (label: string, opts: { muted?: boolean } = {}): NavItem => ({
	href: "",
	label,
	isGroupLabel: true,
	mutedGroup: opts.muted,
});
const leaf = (
	href: string,
	label: string,
	opts: { adminOnly?: boolean; requiredAction?: string } = {},
): NavItem => ({
	href,
	label,
	indent: true,
	adminOnly: opts.adminOnly,
	requiredAction: opts.requiredAction,
});

// Build a core nav leaf whose `requiredAction`/`adminOnly` are sourced from the
// shared NAV_ACTION_MAP data module rather than inlined here, so the sidebar,
// the page guards, and the abac parity audit all read one source of truth.
const mappedLeaf = (href: string, label: string): NavItem => {
	const entry = NAV_ACTION_BY_HREF.get(href);
	return leaf(href, label, {
		adminOnly: entry?.adminOnly,
		requiredAction: entry?.requiredAction,
	});
};

const navigationByKey = adminUi.navigation as Record<string, string>;
const integrationLeaf = (entry: IntegrationEntry): NavItem =>
	leaf(entry.href, navigationByKey[entry.navKey] ?? entry.navKey, {
		adminOnly: entry.adminOnly,
		requiredAction: entry.requiredAction,
	});

function integrationLeavesForGroup(group: "real-or-env-gated" | "coming-soon"): NavItem[] {
	if (group === "real-or-env-gated") {
		const items = INTEGRATIONS.filter(
			(entry) => entry.status === "real" || entry.status === "env-gated",
		).map(integrationLeaf);
		return [groupSep(adminUi.navigation.groupIntegrations), ...items];
	}
	const items = INTEGRATIONS.filter((entry) => entry.status === "coming-soon").map(integrationLeaf);
	if (items.length === 0) return [];
	return [
		// Pulled from admin-labels (10-locale coverage) rather than admin-ui's
		// navigation map, to keep admin-ui.ts unchanged for mutation-gate.
		groupSep(getAdminLabel("navGroupComingSoon", adminLocale), { muted: true }),
		...items,
	];
}

const navItems: NavItem[] = [
	{ href: "/ap-admin", label: adminUi.navigation.dashboard },

	groupSep(adminUi.navigation.groupSite),
	mappedLeaf("/ap-admin/pages", adminUi.navigation.pages),
	mappedLeaf("/ap-admin/route-pages", adminUi.navigation.routePages),
	mappedLeaf("/ap-admin/archives", adminUi.navigation.archives),
	mappedLeaf("/ap-admin/media", adminUi.navigation.media),
	mappedLeaf("/ap-admin/redirects", adminUi.navigation.redirects),
	mappedLeaf("/ap-admin/forms", adminUi.navigation.forms),

	groupSep(adminUi.navigation.contentGroup),
	mappedLeaf("/ap-admin/posts", adminUi.navigation.posts),
	mappedLeaf("/ap-admin/authors", adminUi.navigation.authors),
	mappedLeaf("/ap-admin/taxonomies", adminUi.navigation.taxonomies),
	mappedLeaf("/ap-admin/cms", adminUi.navigation.headlessCmsPanel),

	groupSep(adminUi.navigation.groupAudience),
	mappedLeaf("/ap-admin/subscribers", adminUi.navigation.subscribers),
	mappedLeaf("/ap-admin/newsletter", adminUi.navigation.newsletter),
	mappedLeaf("/ap-admin/comments", adminUi.navigation.comments),
	mappedLeaf("/ap-admin/testimonials", adminUi.navigation.testimonials),
	mappedLeaf("/ap-admin/referrals", adminUi.navigation.referrals),
	mappedLeaf("/ap-admin/memberships", adminUi.navigation.memberships),
	mappedLeaf("/ap-admin/fundraising", adminUi.navigation.fundraising),
	mappedLeaf("/ap-admin/community", adminUi.navigation.community),
	// No "Shop" leaf: shop.astro is a 301 redirect to /ap-admin/services,
	// which already has its own real nav entry (INTEGRATIONS status="real").
	// A separate "Shop" leaf would just duplicate that destination.
	// No "Events" leaf either: promoted to an env-gated INTEGRATIONS entry
	// (like Monitoring/Heatmaps) — its leaf now comes from
	// integrationLeavesForGroup below, not this static array.
	// No "Reviews" leaf either, same reason — gated on the new
	// reviews:manage action, not testimonials:manage.
	mappedLeaf("/ap-admin/social-syndication", adminUi.navigation.socialSyndication),

	groupSep(adminUi.navigation.groupDiscoverability),
	mappedLeaf("/ap-admin/seo", adminUi.navigation.seo),
	mappedLeaf("/ap-admin/structured-data", adminUi.navigation.structuredData),
	mappedLeaf("/ap-admin/sitemaps", adminUi.navigation.sitemaps),
	mappedLeaf("/ap-admin/maps-local", adminUi.navigation.mapsLocal),
	mappedLeaf("/ap-admin/translations", adminUi.navigation.translations),

	// Integration leaves are partitioned by `INTEGRATIONS` so the sidebar
	// stops conflating real features with coming-soon roadmap entries.
	// Real + env-gated render under "Integrations"; coming-soon renders
	// under its own visually demoted "Coming soon" group below.
	...integrationLeavesForGroup("real-or-env-gated"),
	...pluginNavItems,
	...integrationLeavesForGroup("coming-soon"),

	groupSep(adminUi.navigation.groupAccess),
	mappedLeaf("/ap-admin/users", adminUi.navigation.users),
	mappedLeaf("/ap-admin/access", adminUi.navigation.access),

	groupSep(adminUi.navigation.groupOperations),
	mappedLeaf("/ap-admin/system", adminUi.navigation.system),
	...(hasHostPanel ? [mappedLeaf("/ap-admin/host", adminUi.navigation.host)] : []),
	mappedLeaf("/ap-admin/data", adminUi.navigation.data),
	mappedLeaf("/ap-admin/settings", adminUi.navigation.settings),
	mappedLeaf("/ap-admin/backups", adminUi.navigation.backups),
];

// hasCms is kept on Props for backwards compatibility but no longer gates
// nav — every leaf renders unconditionally and individual pages show
// <RequiresIntegration> when their backing config is missing.
void hasCms;

// Derive the heading + document title from the matched nav item so SSR
// localisation flows through to every admin page without each page having
// to translate its own "Pages" / "Posts" / "Settings" prop. Editor pages
// (e.g. /ap-admin/posts/[slug]) pass currentPath=<list-path> for nav
// highlighting but their actual pathname differs — in that case keep the
// prop heading ("Edit Post") rather than the nav label ("Posts").
const matchedNavItem = navItems.find(
	(item) => item.href && item.href === currentPath && !item.isGroupLabel,
);
const isOnMatchedNavRoute = !!matchedNavItem?.href && Astro.url.pathname === matchedNavItem.href;
const localisedHeading = isOnMatchedNavRoute && matchedNavItem ? matchedNavItem.label : heading;
const localisedTitle = isOnMatchedNavRoute && matchedNavItem ? matchedNavItem.label : title;
const documentTitleResolved = isOnMatchedNavRoute
	? buildAstropressAdminDocumentTitle(localisedTitle)
	: documentTitle;
---

<!doctype html>
<html lang={adminLocale} dir={adminDir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    {adminUi.branding.faviconHref && <link rel="icon" href={adminUi.branding.faviconHref} />}
    <link rel="stylesheet" href="/admin.css" />
    {adminUi.branding.stylesheetHref && <link rel="stylesheet" href={adminUi.branding.stylesheetHref} />}
    <title>{documentTitleResolved}</title>
    <meta name="description" content={description || documentTitle} />
  </head>
  <body>
    <a class="skip-link" href="#admin-main">{tLayout("layout.skipToContent")}</a>
    <header class="topbar">
      <a class="topbar-brand" href={adminUi.branding.logoHref}>
        {adminUi.branding.logoSrc ? (
          <img src={adminUi.branding.logoSrc} alt={adminUi.branding.logoAlt} class="topbar-logo" />
        ) : null}
        <strong>{adminSiteName}</strong>
      </a>
      <div class="topbar-meta">
        {canPublish && isAdminRole && (
          <form method="post" action="/ap-admin/actions/publish" class="publish-form">
            <CsrfInput token={Astro.locals.csrfToken} />
            <button type="submit" class="publish-btn" title="Trigger a new production build">
              Publish
            </button>
          </form>
        )}
        <button
          type="button"
          class="nav-toggle"
          data-nav-toggle
          aria-label={tLayout("layout.openNavigation")}
          aria-expanded="false"
          aria-controls="admin-sidebar"
          data-label-open="Open navigation"
          data-label-close="Close navigation"
        >
          <span aria-hidden="true">☰</span>
        </button>
        <span>{adminUi.labels.signedInAsPrefix} {userName}</span>
        <span class="role-chip">{displayRole}</span>
        <details class="topbar-panel-details" id="topbar-utility-details">
          <summary class="topbar-panel-toggle" aria-label={tLayout("layout.toggleUtilityPanel")}>
            <span class="panel-toggle-arrows" aria-hidden="true">
              <svg class="panel-toggle-arrow panel-toggle-arrow-closed" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
              <svg class="panel-toggle-arrow panel-toggle-arrow-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </span>
          </summary>
          <div id="topbar-utility-panel" class="topbar-utility-panel">
          <ap-theme-toggle label-dark={adminUi.labels.themeToggleDark} label-light={adminUi.labels.themeToggleLight}>
            <button
              type="button"
              class="topbar-utility-btn"
              aria-pressed="false"
              aria-label={adminUi.labels.themeToggleDark}
              title={adminUi.labels.themeToggleDark}
            >
              <span class="theme-toggle-icon" aria-hidden="true"></span>
            </button>
          </ap-theme-toggle>
          <select
            class="topbar-utility-btn locale-select"
            aria-label={adminUi.labels.changeLanguage}
            title={adminUi.labels.changeLanguage}
            data-locale-select
          >
            <option value="en" selected={adminLocale === "en"}>EN</option>
            <option value="es" selected={adminLocale === "es"}>ES</option>
            <option value="fr" selected={adminLocale === "fr"}>FR</option>
            <option value="de" selected={adminLocale === "de"}>DE</option>
            <option value="pt" selected={adminLocale === "pt"}>PT</option>
            <option value="ja" selected={adminLocale === "ja"}>JA</option>
            <option value="te" selected={adminLocale === "te"}>TE</option>
            <option value="hi" selected={adminLocale === "hi"}>HI</option>
            <option value="ny" selected={adminLocale === "ny"}>NY</option>
          </select>
          <button
            type="button"
            class="topbar-utility-btn"
            popovertarget="admin-keyboard-shortcuts"
            aria-label={tLayout("layout.keyboardShortcuts")}
            title={tLayout("layout.keyboardShortcuts")}
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2" ry="2"></rect><path d="M6 8h.01M10 8h.01M14 8h.01M18 8h.01M8 12h.01M12 12h.01M16 12h.01M8 16h8"></path></svg>
          </button>
          <button
            type="button"
            class="topbar-utility-btn"
            id="scroll-to-bottom-btn"
            aria-label={tLayout("layout.scrollToBottom")}
            title={tLayout("layout.scrollToBottom")}
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </button>
        </div>
        </details>
        <div
          id="admin-keyboard-shortcuts"
          popover
          class="keyboard-shortcuts-popover"
          role="dialog"
          aria-label={tLayout("layout.keyboardShortcuts")}
        >
          <h2>{tLayout("layout.keyboardShortcuts")}</h2>
          <table>
            <tbody>
              <tr><td><kbd>Ctrl</kbd>+<kbd>S</kbd></td><td>{tLayout("layout.shortcutSaveDraft")}</td></tr>
              <tr><td><kbd>Ctrl</kbd>+<kbd>Enter</kbd></td><td>{tLayout("layout.shortcutPublish")}</td></tr>
              <tr><td><kbd>Escape</kbd></td><td>{tLayout("layout.shortcutEscape")}</td></tr>
              <tr><td><kbd>Tab</kbd></td><td>{tLayout("layout.shortcutTab")}</td></tr>
              <tr><td><kbd>Shift</kbd>+<kbd>Tab</kbd></td><td>{tLayout("layout.shortcutShiftTab")}</td></tr>
              <tr><td><kbd>?</kbd></td><td>{tLayout("layout.shortcutHelp")}</td></tr>
              <tr><td><kbd>Ctrl</kbd>+<kbd>K</kbd></td><td>{tLayout("layout.shortcutCmd")}</td></tr>
            </tbody>
          </table>
        </div>
        <form method="post" action="/ap-admin/session?logout=1">
          <button type="submit">{adminUi.labels.signOut}</button>
        </form>
        <script>
          (function () {
            // Locale: persist choice in a cookie and reload so SSR re-renders labels.
            var sel = document.querySelector('[data-locale-select]') as HTMLSelectElement | null;
            if (sel) {
              var localeSelect = sel;
              localeSelect.addEventListener('change', function () {
                document.cookie = 'astropress_admin_locale=' + encodeURIComponent(localeSelect.value) + '; path=/; max-age=31536000; samesite=Lax';
                window.location.reload();
              });
            }

            // Utility panel: close on click-outside and Escape (details element has no native light-dismiss).
            var details = document.getElementById('topbar-utility-details') as HTMLDetailsElement | null;
            if (details) {
              var utilityDetails = details;
              document.addEventListener('click', function (e) {
                if (utilityDetails.open && !utilityDetails.contains(e.target as Node | null)) utilityDetails.removeAttribute('open');
              });
              document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && utilityDetails.open) { utilityDetails.removeAttribute('open'); e.stopPropagation(); }
              });
            }

            // Sidebar group disclosures: persist open/closed state per-group
            // in localStorage so collapsed groups stay collapsed across pages.
            // Server SSR auto-opens the group containing the current page; the
            // user override (if any) takes precedence after first interaction.
            try {
              var storeKey = 'astropress_admin_nav_groups_v1';
              var raw = window.localStorage.getItem(storeKey);
              var state = raw ? JSON.parse(raw) : {};
              var groupEls = document.querySelectorAll('details[data-nav-group]');
              groupEls.forEach(function (el) {
                var key = el.getAttribute('data-nav-group');
                if (!key) return;
                var groupKey = key;
                if (Object.prototype.hasOwnProperty.call(state, groupKey)) {
                  if (state[groupKey]) el.setAttribute('open', ''); else el.removeAttribute('open');
                }
                el.addEventListener('toggle', function () {
                  state[groupKey] = el.hasAttribute('open');
                  try { window.localStorage.setItem(storeKey, JSON.stringify(state)); } catch (e) { /* quota / disabled — OK */ }
                });
              });
            } catch (e) { /* localStorage disabled — OK, server SSR still picks the right group */ }

            // Down-arrow in the utility bar: scroll the page to the bottom.
            var scrollDownBtn = document.getElementById('scroll-to-bottom-btn');
            if (scrollDownBtn) {
              scrollDownBtn.addEventListener('click', function () {
                window.scrollTo({ top: document.documentElement.scrollHeight, behavior: 'smooth' });
              });
            }

            // Scroll-to-top FAB: shown only after the topbar has scrolled
            // fully out of view. Uses IntersectionObserver against the
            // <header class="topbar"> element so the trigger tracks the
            // actual chrome rather than a magic-number scroll offset.
            var fab = document.getElementById('scroll-to-top-fab');
            var topbar = document.querySelector('header.topbar');
            if (fab && topbar) {
              var fabEl = fab;
              var visible = false;
              function setVisibility(shouldShow: boolean) {
                if (shouldShow === visible) return;
                visible = shouldShow;
                if (shouldShow) {
                  fabEl.hidden = false;
                  requestAnimationFrame(function () { fabEl.classList.add('is-visible'); });
                } else {
                  fabEl.classList.remove('is-visible');
                  setTimeout(function () { if (!visible) fabEl.hidden = true; }, 220);
                }
              }
              var io = new IntersectionObserver(function (entries) {
                // The topbar is "not visible" when none of it intersects the viewport.
                setVisibility(!entries[0].isIntersecting);
              }, { threshold: 0 });
              io.observe(topbar);
              fab.addEventListener('click', function () {
                window.scrollTo({ top: 0, behavior: 'smooth' });
              });
            }
          })();
        </script>
      </div>
    </header>
    <ap-admin-nav>
    <div class="admin-shell">
      <nav id="admin-sidebar" class="sidebar" data-nav-sidebar aria-label={tLayout("layout.adminSections")}>
        <button
          type="button"
          class="nav-close"
          data-nav-close
          aria-label={tLayout("layout.closeNavigation")}
        >
          <span aria-hidden="true">✕</span>
        </button>
        {/*
          Render the flat navItems list as a stack of leaves (before the first
          group label) followed by collapsible <details> sections — one per
          group. Each section auto-opens when it contains the current page so
          the active leaf is always visible. A small client script persists
          per-group open/closed state in localStorage so user preference
          survives page navigation.
        */}
        {(() => {
          const visible = navItems.filter((item) => {
            // Group separators always render — their visibility depends on
            // whether any leaf in the group survives, handled below.
            if (item.isGroupLabel) return true;
            // requiredAction is the source of truth when an access context
            // resolves: nav mirrors what the page guard will allow. Falls
            // back to the legacy adminOnly check when no engine is wired
            // (admin-only seen by admin role; everyone else gated by deny).
            if (item.requiredAction && access) {
              return access.can(item.requiredAction).decision === "allow";
            }
            return item.adminOnly ? isAdminRole : true;
          });
          type Group = { label: string; key: string; muted: boolean; items: NavItem[] };
          const preamble: NavItem[] = [];
          const groups: Group[] = [];
          for (const item of visible) {
            if (item.isGroupLabel) {
              groups.push({
                label: item.label,
                key: item.label.toLowerCase().replace(/[^a-z0-9]+/g, "-"),
                muted: item.mutedGroup === true,
                items: [],
              });
              continue;
            }
            if (groups.length === 0) {
              preamble.push(item);
            } else {
              groups[groups.length - 1].items.push(item);
            }
          }
          const isInGroup = (g: Group): boolean =>
            g.items.some((it) => it.href === currentPath);
          return (
            <>
              {preamble.map((item) => (
                <a
                  href={item.href}
                  aria-current={currentPath === item.href ? "page" : undefined}
                  class={item.indent ? "sidebar-child" : ""}
                >
                  {item.label}
                </a>
              ))}
              {groups.map((g) => (
                <details
                  class="sidebar-group"
                  data-nav-group={g.key}
                  data-coming-soon={g.muted ? "true" : undefined}
                  open={isInGroup(g) || undefined}
                >
                  <summary class="sidebar-group-label">{g.label}</summary>
                  {g.items.map((item) => (
                    <a
                      href={item.href}
                      aria-current={currentPath === item.href ? "page" : undefined}
                      class={item.indent ? "sidebar-child" : ""}
                    >
                      {item.label}
                    </a>
                  ))}
                </details>
              ))}
            </>
          );
        })()}
        {recentItems.length > 0 && (
          <details class="sidebar-group" data-nav-group="recent" open>
            <summary class="sidebar-group-label">{tLayout("layout.recent")}</summary>
            {recentItems.map((item) => (
              <a
                href={item.editHref}
                class="sidebar-child sidebar-recent-item"
                title={item.title}
              >
                {item.title.length > 28 ? item.title.slice(0, 26) + "\u2026" : item.title}
              </a>
            ))}
          </details>
        )}
      </nav>
      <main id="admin-main" tabindex="-1">
        <section class="page-header">
          <h1>{localisedHeading}</h1>
          {description && <p>{description}</p>}
        </section>
        {!bootstrapDisabled && (
          <ap-notice type="warning">
            {tLayout("banner.bootstrap.before")} <a href="/ap-admin/settings">{tLayout("banner.bootstrap.link")}</a> {tLayout("banner.bootstrap.after")}
          </ap-notice>
        )}
        <div
          role="alert"
          aria-live="assertive"
          aria-atomic="true"
          data-action-error
          class="action-error-region"
        ></div>
        <div
          role="status"
          aria-live="polite"
          aria-atomic="true"
          data-action-notice
          class="action-notice-region"
        ></div>
        <slot />
      </main>
    </div>
    </ap-admin-nav>
    <footer class="ap-admin-footer">
      <a
        href="https://docs.astropress.diy"
        target="_blank"
        rel="noopener noreferrer"
        class="ap-admin-footer__link"
      >{tLayout("footer.docs")}</a>
      <span class="ap-admin-footer__sep" aria-hidden="true">·</span>
      <a
        href="https://github.com/Astropress/astropress/issues"
        target="_blank"
        rel="noopener noreferrer"
        class="ap-admin-footer__link"
      >{tLayout("footer.reportIssue")}</a>
      <span class="ap-admin-footer__sep" aria-hidden="true">·</span>
      <a
        href="https://github.com/Astropress/astropress"
        target="_blank"
        rel="noopener noreferrer"
        class="ap-admin-footer__link"
      >Astropress</a>
    </footer>
    <button
      type="button"
      id="scroll-to-top-fab"
      class="scroll-to-top-fab"
      aria-label={tLayout("layout.scrollToTop")}
      title={tLayout("layout.scrollToTop")}
      hidden
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="18 15 12 9 6 15"></polyline></svg>
    </button>
    <ap-command-palette data-nav-items={JSON.stringify(navItems.filter((n) => n.href && !n.isGroupLabel).map((n) => ({ label: n.label, href: n.href })))}>
      <dialog id="cmd-palette" class="cmd-palette" aria-label={tLayout("layout.commandPalette")}>
        <input type="search" class="cmd-input" placeholder={tLayout("layout.goTo")} aria-label={tLayout("layout.searchAdminPages")} autocomplete="off" />
        <ul class="cmd-results" role="listbox" aria-label={tLayout("layout.commandPaletteResults")} aria-live="polite"></ul>
      </dialog>
    </ap-command-palette>
    <script>
      import "../web-components/theme-toggle";
      import "../web-components/admin-nav";
      import "../web-components/notice";
      import "../web-components/command-palette";
      import "../web-components/pending-form";
    </script>
    <script>
      // Progressive enhancement: inline form validation with custom messages.
      // Degrades gracefully when JS is unavailable — browser native validation still applies.
      (function () {
        function getCustomMessage(input: HTMLInputElement): string {
          if (!input.validity.valid) {
            if (input.dataset.errorRequired && input.validity.valueMissing) return input.dataset.errorRequired;
            if (input.dataset.errorPattern && input.validity.patternMismatch) return input.dataset.errorPattern;
            if (input.dataset.errorMinlength && input.validity.tooShort) return input.dataset.errorMinlength;
            if (input.dataset.errorType && (input.validity.typeMismatch || input.validity.badInput)) return input.dataset.errorType;
          }
          return input.validationMessage;
        }

        function showError(input: HTMLInputElement): void {
          const describedBy = input.getAttribute("aria-describedby");
          let errorEl = describedBy ? document.getElementById(describedBy) : null;
          if (!errorEl) {
            const id = `field-error-${Math.random().toString(36).slice(2)}`;
            errorEl = document.createElement("span");
            errorEl.id = id;
            errorEl.className = "field-error";
            errorEl.setAttribute("aria-live", "polite");
            input.insertAdjacentElement("afterend", errorEl);
            input.setAttribute("aria-describedby", id);
          }
          const msg = getCustomMessage(input);
          errorEl.textContent = msg;
          input.setAttribute("aria-invalid", msg ? "true" : "false");
        }

        function clearError(input: HTMLInputElement): void {
          input.setCustomValidity("");
          const id = input.getAttribute("aria-describedby");
          const errorEl = id ? document.getElementById(id) : null;
          if (errorEl) errorEl.textContent = "";
          input.setAttribute("aria-invalid", "false");
        }

        document.addEventListener("invalid", (e) => {
          const input = e.target as HTMLElement;
          if (!(input instanceof HTMLInputElement || input instanceof HTMLTextAreaElement || input instanceof HTMLSelectElement)) return;
          e.preventDefault();
          showError(input as HTMLInputElement);
        }, true);

        document.addEventListener("input", (e) => {
          const input = e.target as HTMLElement;
          if (!(input instanceof HTMLInputElement || input instanceof HTMLTextAreaElement)) return;
          if (input.getAttribute("aria-invalid") === "true") clearError(input as HTMLInputElement);
        });

        // Restore session-storage error messages (set by server actions to keep sensitive names out of URL history).
        const storedError = sessionStorage.getItem("ap_action_error");
        if (storedError) {
          sessionStorage.removeItem("ap_action_error");
          const liveRegion = document.querySelector<HTMLElement>("[aria-live='assertive'][data-action-error]");
          if (liveRegion) liveRegion.textContent = storedError;
        }

        // Surface access-deny redirects from requiresAccess() page guard.
        // The guard sets ?error=insufficient-permissions&reason=<encoded reason>
        // and form actions set ?error=1&message=<encoded message> — both
        // map to the shared action-error live region.
        {
          const params = new URLSearchParams(window.location.search);
          const error = params.get("error");
          const messageParam = params.get("message") ?? params.get("reason");
          if (error && messageParam) {
            const liveRegion = document.querySelector<HTMLElement>("[aria-live='assertive'][data-action-error]");
            if (liveRegion && !liveRegion.textContent) {
              liveRegion.textContent = messageParam;
            }
          }
          // Success counterpart: ?notice=1&message=… (e.g. publish confirmation).
          const notice = params.get("notice");
          if (notice && messageParam) {
            const noticeRegion = document.querySelector<HTMLElement>("[data-action-notice]");
            if (noticeRegion && !noticeRegion.textContent) {
              noticeRegion.textContent = messageParam;
            }
          }
        }

        // Optimistic publish button — disable and relabel on submit; page navigation completes naturally.
        document.querySelector(".publish-form")?.addEventListener("submit", (e) => {
          const btn = (e.currentTarget as HTMLFormElement).querySelector<HTMLButtonElement>(".publish-btn");
          if (btn) { btn.textContent = "Publishing\u2026"; btn.disabled = true; }
        });

        // Generic form submit loading state — disable button and append ellipsis to prevent double submission.
        document.querySelectorAll<HTMLFormElement>("form:not(.publish-form)").forEach((form) => {
          form.addEventListener("submit", () => {
            const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
            if (!btn || btn.disabled) return;
            btn.disabled = true;
            const original = btn.textContent?.trim() ?? "";
            btn.textContent = original + "\u2026";
            setTimeout(() => { btn.disabled = false; btn.textContent = original; }, 8000);
          });
        });
      })();
    </script>
  <style>
    .ap-admin-footer {
      padding: 0.5rem 1.5rem;
      font-size: 0.75rem;
      color: var(--muted);
      border-top: 1px solid var(--line);
      display: flex;
      gap: 0.5rem;
      align-items: center;
    }
    .ap-admin-footer__link {
      color: var(--text);
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      min-height: 2.75rem;
      padding: 0 0.5rem;
    }
    .ap-admin-footer__link:hover {
      text-decoration: underline;
    }
    .ap-admin-footer__sep {
      color: var(--muted);
    }
  </style>
  </body>
</html>
